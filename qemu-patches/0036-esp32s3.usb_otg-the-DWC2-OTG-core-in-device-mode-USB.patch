diff --git a/include/hw/misc/esp32s3_usb_otg.h b/include/hw/misc/esp32s3_usb_otg.h
new file mode 100644
index 0000000..de89057
--- /dev/null
+++ b/include/hw/misc/esp32s3_usb_otg.h
@@ -0,0 +1,68 @@
+/*
+ * ESP32-S3 USB OTG (Synopsys DWC2 FS core at 0x60080000) in device mode, with the two
+ * small blocks that route the internal full-speed PHY to it: USB_WRAP (0x60039000) and
+ * RTC_CNTL_USB_CONF (0x60008120). Enough for TinyUSB's dcd_dwc2 to initialise and to sit
+ * on an idle bus (no host: no bus reset, no SOF, no SETUP), and a small built-in host that,
+ * on request, resets the bus and reads the device descriptor the firmware returns
+ * (GET_DESCRIPTOR(Device) on EP0). No other transfer.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32S3_USB_OTG "esp32s3.usb_otg"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3UsbOtgState, ESP32S3_USB_OTG)
+
+#define ESP32S3_USB_OTG_BASE       0x60080000
+#define ESP32S3_USB_OTG_SIZE       0x40000     /* registers, 16 FIFO windows, direct FIFO RAM access */
+#define ESP32S3_USB_OTG_REGS       0x1000      /* the register file proper */
+#define ESP32S3_USB_WRAP_SIZE      0x1000
+#define ESP32S3_RTC_USB_CONF_OFF   0x120       /* RTC_CNTL_USB_CONF_REG */
+#define ESP32S3_USB_OTG_EPS        7           /* EP0 + GHWCFG2.NUMDEVEPS (6) */
+#define ESP32S3_USB_OTG_RXQ        8           /* host-side RX FIFO entries (status words) */
+#define ESP32S3_USB_OTG_DESC_MAX   64
+
+typedef struct ESP32S3UsbOtgRxEntry {
+    uint32_t sts;                 /* GRXSTSP word */
+    uint32_t data[2];             /* up to 8 bytes (a SETUP packet); OUT data is never more here */
+    uint8_t words, popped;        /* data words in the FIFO behind this entry, words read so far */
+} ESP32S3UsbOtgRxEntry;
+
+struct ESP32S3UsbOtgState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;           /* 0: DWC2 core */
+    MemoryRegion wrap_mem;        /* 1: USB_WRAP */
+    MemoryRegion usb_conf_mem;    /* 2: RTC_CNTL_USB_CONF, one word */
+    qemu_irq irq;
+
+    uint32_t reg[ESP32S3_USB_OTG_REGS / 4];
+    uint32_t wrap_otg_conf, wrap_test_conf, wrap_date;
+    uint32_t rtc_usb_conf;
+    bool in_nak, out_nak;         /* DCTL global IN / OUT NAK in effect */
+    bool irq_level;
+
+    /* counters for the board state */
+    uint64_t reads, writes, core_resets, rx_flushes, tx_flushes, irq_raises;
+    uint64_t connects, disconnects, fifo_words_in, fifo_words_out;
+
+    /* the built-in host: one enumeration (bus reset, GET_DESCRIPTOR(Device), status) */
+    QEMUTimer host_timer;
+    int host_step;                /* 0 idle; see esp32s3_usb_otg.c */
+    char host_error[64];
+    uint64_t host_resets, host_setups;
+    ESP32S3UsbOtgRxEntry rxq[ESP32S3_USB_OTG_RXQ];
+    int rxq_head, rxq_len;
+    ESP32S3UsbOtgRxEntry rx_cur;  /* the entry GRXSTSP popped last: its data words come next */
+    bool host_short;              /* the data stage ended with a short packet */
+    uint16_t host_wlength;
+    uint8_t desc[ESP32S3_USB_OTG_DESC_MAX];
+    int desc_len;
+    uint8_t pkt[ESP32S3_USB_OTG_DESC_MAX];   /* the IN packet being written into FIFO 0 */
+    int pkt_len;
+    int64_t host_t0_ns;
+};
+
+/* the state the board reports as `usb_otg` (one JSON object, appended to j) */
+void esp32s3_usb_otg_state_json(ESP32S3UsbOtgState *s, GString *j);
