diff --git a/hw/misc/x4pro_ana_i2c.c b/hw/misc/x4pro_ana_i2c.c
new file mode 100644
index 0000000..fb498b4
--- /dev/null
+++ b/hw/misc/x4pro_ana_i2c.c
@@ -0,0 +1,174 @@
+/*
+ * ESP32-S3 analog-master I2C block ("I2C_ANA_MST", 0x6000E000, 4 KB).
+ *
+ * Nothing in Espressif's SoC answers this block; its silent catch-all returns 0,
+ * which parks the stock firmware's WiFi task in ROM rom_pkdet_vol_start polling
+ * +0x50 for a state that never comes (docs/log.md 2026-09-06). Protocol, from the
+ * ROM (images/rom/esp32s3_rev0_rom.elf) and ESP-IDF's regi2c_ctrl_ll.h:
+ *
+ *   +0x00 / +0x04  master 0 / 1 command word (rom_chip_i2c_readReg_org,
+ *                  rom_chip_i2c_writeReg, rom_i2c_paral_read/write):
+ *                    [7:0] slave block (BBPLL 0x66, SAR ADC 0x69, DIG_REG 0x6D,
+ *                          BOD/ULP 0x61, radio 0x62..0x64), [15:8] register,
+ *                    [23:16] data, bit 24 write, bit 25 busy, bit 26 start.
+ *                  The ROM polls busy clear, then takes a read's answer from
+ *                  [23:16]. rom_get_i2c_hostid picks master 1 for 0x62..0x64.
+ *   +0x40  ANA_CONF0: BBPLL calibration STOP_FORCE_HIGH/LOW bits 2/3, CAL_DONE
+ *          bit 24 answered set.
+ *   +0x44  ANA_CONFIG (per-block enables, a cleared bit enables), +0x48 ANA_CONFIG2.
+ *   +0x50  SAR2 power detector: bit 1 start (rom_pkdet_vol_start), bits 26:24 state,
+ *          7 = idle/done, polled before and after the start; bits 6,7 rom_en_pwdet.
+ *   +0x5C / +0x60  detector configuration (rom_pwdet_sar2_init: 0x16a, bits 19..23;
+ *          rom_get_sar2_vol: bits 4:3 select the input).
+ *   +0x80..+0x9C  eight 13-bit SAR2 samples (rom_read_sar_dout), answered with
+ *          the "sar2-code" property.
+ *
+ * The analog registers behind the masters are stored per (block, register) and
+ * read back as written; no PLL, ADC or radio behaviour is derived from them.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/x4pro_ana_i2c.h"
+
+#define R_MST0          0x00
+#define R_MST1          0x04
+#define R_ANA_CONF0     0x40
+#define R_ANA_CONFIG    0x44
+#define R_ANA_CONFIG2   0x48
+#define R_SAR2_CTRL     0x50
+#define R_SAR2_CONF1    0x5C
+#define R_SAR2_CONF2    0x60
+#define R_SAR2_DOUT0    0x80
+#define R_SAR2_DOUT7    0x9C
+
+#define CMD_BLOCK(v)    ((v) & 0xFF)
+#define CMD_REG(v)      (((v) >> 8) & 0xFF)
+#define CMD_DATA(v)     (((v) >> 16) & 0xFF)
+#define CMD_WRITE       (1u << 24)
+#define CMD_BUSY        (1u << 25)
+#define CMD_START       (1u << 26)
+
+#define ANA_CONF0_BBPLL_CAL_DONE (1u << 24)
+#define SAR2_CTRL_START          (1u << 1)
+#define SAR2_CTRL_STATE_DONE     (7u << 24)
+#define SAR2_CODE_MASK           0x1FFF
+
+static void x4pro_ana_i2c_command(X4ProAnaI2cState *s, int master, uint32_t v)
+{
+    uint8_t block = CMD_BLOCK(v), reg = CMD_REG(v), data = CMD_DATA(v);
+    bool write = v & CMD_WRITE;
+    if (write) {
+        s->mem[block][reg] = data;
+        s->writes++;
+    } else {
+        data = s->mem[block][reg];
+        s->reads++;
+    }
+    s->last_master = master;
+    s->last_block = block;
+    s->last_reg = reg;
+    s->last_data = data;
+    /* busy never shows; a read leaves its answer in the data field */
+    s->reg[master] = (v & ~(CMD_BUSY | (0xFFu << 16))) | ((uint32_t)data << 16);
+    if (s->log) {
+        qemu_log_mask(LOG_UNIMP, "x4pro.ana-i2c: m%d %s block 0x%02x reg 0x%02x data 0x%02x\n",
+                      master, write ? "wr" : "rd", block, reg, data);
+    }
+}
+
+static uint64_t x4pro_ana_i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X4ProAnaI2cState *s = X4PRO_ANA_I2C(opaque);
+    uint32_t v = s->reg[addr / 4];
+    switch (addr) {
+    case R_MST0:
+    case R_MST1:
+        return v & ~CMD_BUSY;
+    case R_ANA_CONF0:
+        return v | ANA_CONF0_BBPLL_CAL_DONE;
+    case R_SAR2_CTRL:
+        return (v & ~SAR2_CTRL_STATE_DONE) | SAR2_CTRL_STATE_DONE;
+    case R_SAR2_DOUT0 ... R_SAR2_DOUT7:
+        return s->sar2_code & SAR2_CODE_MASK;
+    default:
+        return v;
+    }
+}
+
+static void x4pro_ana_i2c_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    X4ProAnaI2cState *s = X4PRO_ANA_I2C(opaque);
+    uint32_t v = value;
+    switch (addr) {
+    case R_MST0:
+    case R_MST1:
+        x4pro_ana_i2c_command(s, addr / 4, v);
+        return;
+    case R_SAR2_CTRL:
+        if ((v & SAR2_CTRL_START) && !(s->reg[addr / 4] & SAR2_CTRL_START)) {
+            s->sar2_starts++;
+        }
+        break;
+    case R_SAR2_DOUT0 ... R_SAR2_DOUT7:
+        return;   /* read-only samples */
+    default:
+        break;
+    }
+    s->reg[addr / 4] = v;
+}
+
+static const MemoryRegionOps x4pro_ana_i2c_ops = {
+    .read = x4pro_ana_i2c_read,
+    .write = x4pro_ana_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void x4pro_ana_i2c_reset_hold(Object *obj, ResetType type)
+{
+    X4ProAnaI2cState *s = X4PRO_ANA_I2C(obj);
+    memset(s->reg, 0, sizeof(s->reg));
+    memset(s->mem, 0, sizeof(s->mem));
+}
+
+static void x4pro_ana_i2c_init(Object *obj)
+{
+    X4ProAnaI2cState *s = X4PRO_ANA_I2C(obj);
+    memory_region_init_io(&s->iomem, obj, &x4pro_ana_i2c_ops, s, TYPE_X4PRO_ANA_I2C, X4PRO_ANA_I2C_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static Property x4pro_ana_i2c_properties[] = {
+    DEFINE_PROP_UINT32("sar2-code", X4ProAnaI2cState, sar2_code, 0x800),
+    DEFINE_PROP_BOOL("log", X4ProAnaI2cState, log, true),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void x4pro_ana_i2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = x4pro_ana_i2c_reset_hold;
+    device_class_set_props(dc, x4pro_ana_i2c_properties);
+}
+
+static const TypeInfo x4pro_ana_i2c_info = {
+    .name = TYPE_X4PRO_ANA_I2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(X4ProAnaI2cState),
+    .instance_init = x4pro_ana_i2c_init,
+    .class_init = x4pro_ana_i2c_class_init,
+};
+
+static void x4pro_ana_i2c_register_types(void)
+{
+    type_register_static(&x4pro_ana_i2c_info);
+}
+
+type_init(x4pro_ana_i2c_register_types)
