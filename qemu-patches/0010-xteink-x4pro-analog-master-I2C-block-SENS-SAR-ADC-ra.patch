diff --git a/include/hw/misc/esp32s3_rfstub.h b/include/hw/misc/esp32s3_rfstub.h
new file mode 100644
index 0000000..7c431e4
--- /dev/null
+++ b/include/hw/misc/esp32s3_rfstub.h
@@ -0,0 +1,50 @@
+/*
+ * ESP32-S3 radio register stub: FE2 (0x60005000), FE (0x60006000), NRX/RX
+ * (0x6001C000), BB (0x6001D000) and the WiFi MAC (0x60033000). Plain storage so read-modify-write holds,
+ * plus "sticky" status bits that read as set so the PHY's calibration polls
+ * complete instead of spinning. No radio behaviour.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/misc/x4pro_hotlog.h"
+
+#define TYPE_ESP32S3_RFSTUB "esp32s3.rfstub"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3RfStubState, ESP32S3_RFSTUB)
+
+#define ESP32S3_RFSTUB_REGIONS 5
+#define ESP32S3_RFSTUB_REGION_SIZE 0x1000
+#define ESP32S3_RFSTUB_MAX_STICKY 64
+
+typedef struct ESP32S3RfStubRegion {
+    const char *name;
+    hwaddr base;
+    uint32_t size;
+    MemoryRegion mr;
+    uint32_t reg[ESP32S3_RFSTUB_REGION_SIZE / 4];
+    struct ESP32S3RfStubState *owner;
+} ESP32S3RfStubRegion;
+
+typedef struct ESP32S3RfStubSticky {
+    hwaddr addr;
+    uint32_t mask;
+} ESP32S3RfStubSticky;
+
+struct ESP32S3RfStubState {
+    SysBusDevice parent_obj;
+    ESP32S3RfStubRegion region[ESP32S3_RFSTUB_REGIONS];
+    ESP32S3RfStubSticky sticky[ESP32S3_RFSTUB_MAX_STICKY];
+    int n_sticky;
+    char *sticky_prop;       /* "0xADDR:0xMASK,..." added to the built-in table */
+    X4ProHotLog hot;
+    uint64_t reads, writes;
+};
+
+typedef struct ESP32S3RfStubMap {
+    const char *name;
+    hwaddr base;
+    uint32_t size;
+} ESP32S3RfStubMap;
+
+extern const ESP32S3RfStubMap esp32s3_rfstub_map[ESP32S3_RFSTUB_REGIONS];
diff --git a/include/hw/misc/esp32s3_saradc.h b/include/hw/misc/esp32s3_saradc.h
new file mode 100644
index 0000000..0238562
--- /dev/null
+++ b/include/hw/misc/esp32s3_saradc.h
@@ -0,0 +1,29 @@
+/*
+ * ESP32-S3 SENS block (0x60008800): SAR ADC oneshot control (RTC path),
+ * temperature sensor, RTC peripheral clock gates. Minimal model: a oneshot
+ * completes immediately with a configurable code, the temperature sensor is
+ * always ready with a configurable output, every other register reads back
+ * as written. The APB_SARADC (DMA/digital controller, 0x60040000) is not here.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_SARADC "esp32s3.saradc"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3SarAdcState, ESP32S3_SARADC)
+
+#define ESP32S3_SENS_SIZE 0x400
+
+struct ESP32S3SarAdcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+
+    uint32_t reg[ESP32S3_SENS_SIZE / 4];
+
+    uint32_t sar1_data, sar2_data;   /* 12-bit codes answered by the oneshot */
+    uint32_t tsens_out;              /* 8-bit temperature sensor output */
+
+    uint64_t sar1_starts, sar2_starts, tsens_reads;
+    uint32_t sar1_pad, sar2_pad;     /* EN_PAD mask of the last oneshot */
+};
diff --git a/include/hw/misc/x4pro_ana_i2c.h b/include/hw/misc/x4pro_ana_i2c.h
new file mode 100644
index 0000000..f844bca
--- /dev/null
+++ b/include/hw/misc/x4pro_ana_i2c.h
@@ -0,0 +1,30 @@
+/*
+ * ESP32-S3 analog-master I2C block (I2C_ANA_MST, 0x6000E000): the register masters
+ * behind rom_i2c_readReg/writeReg, ESP-IDF's ANA_CONF registers and the SAR2
+ * power-detector path the PHY polls. Answers as idle hardware would; keeps the
+ * analog registers per (block, register) so read-modify-write sequences hold.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_X4PRO_ANA_I2C "x4pro.ana-i2c"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProAnaI2cState, X4PRO_ANA_I2C)
+
+#define X4PRO_ANA_I2C_SIZE 0x1000
+
+struct X4ProAnaI2cState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+
+    uint32_t reg[X4PRO_ANA_I2C_SIZE / 4];   /* last written value of every register */
+    uint8_t mem[256][256];                   /* analog registers: [block][register] */
+
+    uint32_t sar2_code;                      /* 13-bit sample answered at +0x80..+0x9C */
+    bool log;                                /* log every master transaction (-d unimp) */
+
+    uint64_t reads, writes;                  /* master transactions */
+    uint64_t sar2_starts;                    /* +0x50 bit 1 set */
+    uint8_t last_master, last_block, last_reg, last_data;
+};
diff --git a/include/hw/misc/x4pro_hotlog.h b/include/hw/misc/x4pro_hotlog.h
new file mode 100644
index 0000000..eace2c8
--- /dev/null
+++ b/include/hw/misc/x4pro_hotlog.h
@@ -0,0 +1,91 @@
+/*
+ * Capped access logger with per-address counters. The first `cap` accesses of
+ * every (address, direction) go to the QEMU log (-d unimp) as before; later ones
+ * are only counted, so a firmware poll cannot grow qemu.log without bound, and
+ * the counters name the polled register (board state JSON, "hot" lists).
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "exec/hwaddr.h"
+
+typedef struct X4ProHotEnt {
+    uint64_t reads, writes;
+} X4ProHotEnt;
+
+typedef struct X4ProHotLog {
+    const char *name;
+    GHashTable *tab;      /* addr -> X4ProHotEnt* */
+    unsigned cap;
+} X4ProHotLog;
+
+static inline void x4pro_hotlog_init(X4ProHotLog *h, const char *name, unsigned cap)
+{
+    h->name = name;
+    h->cap = cap;
+    h->tab = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, g_free);
+}
+
+static inline void x4pro_hotlog_hit(X4ProHotLog *h, hwaddr addr, bool write, uint64_t value, unsigned size)
+{
+    int64_t key = addr;
+    X4ProHotEnt *e = g_hash_table_lookup(h->tab, &key);
+    if (!e) {
+        int64_t *k = g_new(int64_t, 1);
+        *k = key;
+        e = g_new0(X4ProHotEnt, 1);
+        g_hash_table_insert(h->tab, k, e);
+    }
+    uint64_t n = write ? ++e->writes : ++e->reads;
+    if (n > h->cap) {
+        return;
+    }
+    if (write) {
+        qemu_log_mask(LOG_UNIMP, "x4pro/%s: write 0x%08" HWADDR_PRIx " = 0x%08" PRIx64 " size %u%s\n",
+                      h->name, addr, value, size, n == h->cap ? " (further writes only counted)" : "");
+    } else {
+        qemu_log_mask(LOG_UNIMP, "x4pro/%s: read  0x%08" HWADDR_PRIx " size %u%s\n",
+                      h->name, addr, size, n == h->cap ? " (further reads only counted)" : "");
+    }
+}
+
+typedef struct X4ProHotRow {
+    int64_t addr;
+    uint64_t reads, writes;
+} X4ProHotRow;
+
+static inline int x4pro_hotlog_cmp(const void *a, const void *b)
+{
+    const X4ProHotRow *x = a, *y = b;
+    uint64_t sx = x->reads + x->writes, sy = y->reads + y->writes;
+    return sx < sy ? 1 : sx > sy ? -1 : 0;
+}
+
+/* Append a JSON array of the `top` busiest addresses that exceeded the cap; returns the count. */
+static inline int x4pro_hotlog_json(X4ProHotLog *h, GString *j, int top)
+{
+    GArray *rows = g_array_new(false, false, sizeof(X4ProHotRow));
+    GHashTableIter it;
+    gpointer k, v;
+    g_hash_table_iter_init(&it, h->tab);
+    while (g_hash_table_iter_next(&it, &k, &v)) {
+        X4ProHotEnt *e = v;
+        if (e->reads + e->writes > h->cap) {
+            X4ProHotRow r = { *(int64_t *)k, e->reads, e->writes };
+            g_array_append_val(rows, r);
+        }
+    }
+    qsort(rows->data, rows->len, sizeof(X4ProHotRow), x4pro_hotlog_cmp);
+    g_string_append_c(j, '[');
+    int n = MIN((int)rows->len, top);
+    for (int i = 0; i < n; i++) {
+        X4ProHotRow *r = &g_array_index(rows, X4ProHotRow, i);
+        g_string_append_printf(j, "%s{\"addr\":\"0x%08" PRIx64 "\",\"reads\":%" PRIu64 ",\"writes\":%" PRIu64 "}",
+                               i ? "," : "", (uint64_t)r->addr, r->reads, r->writes);
+    }
+    g_string_append_c(j, ']');
+    g_array_free(rows, true);
+    return n;
+}
