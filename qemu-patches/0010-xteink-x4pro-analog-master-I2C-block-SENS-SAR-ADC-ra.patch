diff --git a/hw/misc/esp32s3_rfstub.c b/hw/misc/esp32s3_rfstub.c
new file mode 100644
index 0000000..2e56be9
--- /dev/null
+++ b/hw/misc/esp32s3_rfstub.c
@@ -0,0 +1,168 @@
+/*
+ * ESP32-S3 radio register stub (FE2, FE, RX/NRX, BB and WiFi MAC blocks).
+ *
+ * The stock firmware's PHY (libphy, phy_version 711) programs these blocks
+ * during WiFi start and polls completion flags in them with no timeout; the
+ * SoC's silent catch-all (reads 0) parks the WiFi task there at priority 23
+ * and starves core 0. Nothing here models the radio: registers are storage
+ * (writes read back), and a table of status bits reads as set:
+ *
+ *   FE 0x60006174 bit 16 - measurement done, polled after FE 0x144 bit 1 and
+ *                           RX 0x6001C02C bit 23 start a capture (the loop at
+ *                           app 0x422e2cf9 counts RX 0x6001C08C[18:12] <= 69
+ *                           iterations while it waits).
+ *   MAC 0x60033D14 bit 0 - ready after the driver sets bit 1 (app 0x4230bfa6,
+ *                           first MAC access after phy_init; the device prints
+ *                           "wifi:mode : sta" right after).
+ *
+ * The "sticky" property ("0xADDR:0xMASK,...") extends the table at run time
+ * so a new poll found in the hot list (board state "rf") can be answered
+ * without a rebuild; add it here once it is understood.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/cutils.h"
+#include "qapi/error.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32s3_rfstub.h"
+
+const ESP32S3RfStubMap esp32s3_rfstub_map[ESP32S3_RFSTUB_REGIONS] = {
+    { "fe2", 0x60005000, 0x1000 },
+    { "fe",  0x60006000, 0x1000 },
+    { "rx",  0x6001C000, 0x1000 },   /* NRX proper starts at +0xC00 */
+    { "bb",  0x6001D000, 0x1000 },
+    { "mac", 0x60033000, 0x1000 },
+};
+
+static const ESP32S3RfStubSticky esp32s3_rfstub_builtin[] = {
+    { 0x60006174, 1u << 16 },   /* FE measurement done */
+    { 0x60033D14, 1u << 0 },    /* MAC ready after bit 1 */
+};
+
+static uint32_t esp32s3_rfstub_sticky_mask(ESP32S3RfStubState *s, hwaddr addr)
+{
+    uint32_t m = 0;
+    for (int i = 0; i < s->n_sticky; i++) {
+        if (s->sticky[i].addr == addr) {
+            m |= s->sticky[i].mask;
+        }
+    }
+    return m;
+}
+
+static uint64_t esp32s3_rfstub_read(void *opaque, hwaddr off, unsigned size)
+{
+    ESP32S3RfStubRegion *r = opaque;
+    ESP32S3RfStubState *s = r->owner;
+    hwaddr addr = r->base + off;
+    uint32_t v = r->reg[off / 4] | esp32s3_rfstub_sticky_mask(s, addr);
+    s->reads++;
+    x4pro_hotlog_hit(&s->hot, addr, false, 0, size);
+    return v;
+}
+
+static void esp32s3_rfstub_write(void *opaque, hwaddr off, uint64_t value, unsigned size)
+{
+    ESP32S3RfStubRegion *r = opaque;
+    ESP32S3RfStubState *s = r->owner;
+    r->reg[off / 4] = value;
+    s->writes++;
+    x4pro_hotlog_hit(&s->hot, r->base + off, true, value, size);
+}
+
+static const MemoryRegionOps esp32s3_rfstub_ops = {
+    .read = esp32s3_rfstub_read,
+    .write = esp32s3_rfstub_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32s3_rfstub_add_sticky(ESP32S3RfStubState *s, hwaddr addr, uint32_t mask, Error **errp)
+{
+    if (s->n_sticky >= ESP32S3_RFSTUB_MAX_STICKY) {
+        error_setg(errp, "esp32s3.rfstub: too many sticky entries");
+        return;
+    }
+    s->sticky[s->n_sticky].addr = addr;
+    s->sticky[s->n_sticky].mask = mask;
+    s->n_sticky++;
+}
+
+static void esp32s3_rfstub_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3RfStubState *s = ESP32S3_RFSTUB(dev);
+    for (size_t i = 0; i < ARRAY_SIZE(esp32s3_rfstub_builtin); i++) {
+        esp32s3_rfstub_add_sticky(s, esp32s3_rfstub_builtin[i].addr, esp32s3_rfstub_builtin[i].mask, errp);
+    }
+    if (s->sticky_prop && s->sticky_prop[0]) {
+        g_auto(GStrv) items = g_strsplit(s->sticky_prop, ",", -1);
+        for (char **it = items; *it; it++) {
+            uint64_t a, m;
+            char *colon = strchr(*it, ':');
+            if (!colon || qemu_strtou64(*it, NULL, 0, &a) || qemu_strtou64(colon + 1, NULL, 0, &m)) {
+                error_setg(errp, "esp32s3.rfstub: bad sticky entry '%s' (want 0xADDR:0xMASK)", *it);
+                return;
+            }
+            esp32s3_rfstub_add_sticky(s, a, m, errp);
+        }
+    }
+}
+
+static void esp32s3_rfstub_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3RfStubState *s = ESP32S3_RFSTUB(obj);
+    for (int i = 0; i < ESP32S3_RFSTUB_REGIONS; i++) {
+        memset(s->region[i].reg, 0, sizeof(s->region[i].reg));
+    }
+}
+
+static void esp32s3_rfstub_init(Object *obj)
+{
+    ESP32S3RfStubState *s = ESP32S3_RFSTUB(obj);
+    x4pro_hotlog_init(&s->hot, "rf", 32);
+    for (int i = 0; i < ESP32S3_RFSTUB_REGIONS; i++) {
+        ESP32S3RfStubRegion *r = &s->region[i];
+        char name[32];
+        r->name = esp32s3_rfstub_map[i].name;
+        r->base = esp32s3_rfstub_map[i].base;
+        r->size = MIN(esp32s3_rfstub_map[i].size, ESP32S3_RFSTUB_REGION_SIZE);
+        r->owner = s;
+        snprintf(name, sizeof(name), "esp32s3.rfstub.%s", r->name);
+        memory_region_init_io(&r->mr, obj, &esp32s3_rfstub_ops, r, name, r->size);
+        sysbus_init_mmio(SYS_BUS_DEVICE(obj), &r->mr);
+    }
+}
+
+static Property esp32s3_rfstub_properties[] = {
+    DEFINE_PROP_STRING("sticky", ESP32S3RfStubState, sticky_prop),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32s3_rfstub_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    dc->realize = esp32s3_rfstub_realize;
+    rc->phases.hold = esp32s3_rfstub_reset_hold;
+    device_class_set_props(dc, esp32s3_rfstub_properties);
+}
+
+static const TypeInfo esp32s3_rfstub_info = {
+    .name = TYPE_ESP32S3_RFSTUB,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3RfStubState),
+    .instance_init = esp32s3_rfstub_init,
+    .class_init = esp32s3_rfstub_class_init,
+};
+
+static void esp32s3_rfstub_register_types(void)
+{
+    type_register_static(&esp32s3_rfstub_info);
+}
+
+type_init(esp32s3_rfstub_register_types)
diff --git a/hw/misc/esp32s3_saradc.c b/hw/misc/esp32s3_saradc.c
new file mode 100644
index 0000000..2a71299
--- /dev/null
+++ b/hw/misc/esp32s3_saradc.c
@@ -0,0 +1,156 @@
+/*
+ * ESP32-S3 SENS block (DR_REG_SENS_BASE 0x60008800, 1 KB): the RTC-side SAR ADC
+ * controller, the temperature sensor and the RTC peripheral clock gates.
+ *
+ * Why: the stock firmware's PHY reads the chip temperature during its WiFi start
+ * (SENS_SAR_TSENS_CTRL: power up, then poll TSENS_READY forever) and samples the
+ * power detector through SAR2 (SENS_SAR_MEAS2_CTRL2: START_SAR, then poll
+ * DONE_SAR); ESP-IDF's adc_oneshot and temperature_sensor drivers use the same
+ * registers. Espressif's SoC leaves the block to its silent catch-all (reads 0),
+ * so every such poll spins.
+ *
+ * Model: a oneshot started with MEASx_START_SAR is complete on the next read
+ * (DONE_SAR set, DATA_SAR = the "sar1-data"/"sar2-data" property); the
+ * temperature sensor answers TSENS_READY with TSENS_OUT = "tsens-out"
+ * (ESP-IDF: T = 0.4386 * out - 20.52 in the default range; 104 = ~25 C).
+ * All other registers are plain storage (clock gates, attenuation, mux, touch,
+ * ULP co-processor interrupt registers), which is what the firmware expects of
+ * configuration it never reads back for status.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32s3_saradc.h"
+
+#define R_SAR_MEAS1_CTRL2   0x0C
+#define R_SAR_MEAS2_CTRL2   0x30
+#define R_SAR_TSENS_CTRL    0x50
+#define R_SAR_COCPU_INT_RAW 0xE8
+#define R_SAR_COCPU_INT_ST  0xF0
+#define R_SAR_COCPU_INT_CLR 0xF4
+#define R_SAR_COCPU_INT_ENA_W1TS 0x10C
+#define R_SAR_COCPU_INT_ENA_W1TC 0x110
+#define R_SAR_COCPU_INT_ENA 0xEC
+
+#define MEAS_DATA_SAR_MASK  0xFFFFu
+#define MEAS_DONE_SAR       (1u << 16)
+#define MEAS_START_SAR      (1u << 17)
+#define MEAS_EN_PAD_SHIFT   19
+#define MEAS_EN_PAD_MASK    0xFFFu
+
+#define TSENS_OUT_MASK      0xFFu
+#define TSENS_READY         (1u << 8)
+
+static uint64_t esp32s3_saradc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3SarAdcState *s = ESP32S3_SARADC(opaque);
+    uint32_t v = s->reg[addr / 4];
+    switch (addr) {
+    case R_SAR_MEAS1_CTRL2:
+        if (v & MEAS_START_SAR) {
+            return (v & ~MEAS_DATA_SAR_MASK) | MEAS_DONE_SAR | (s->sar1_data & MEAS_DATA_SAR_MASK);
+        }
+        return v & ~(MEAS_DONE_SAR | MEAS_DATA_SAR_MASK);
+    case R_SAR_MEAS2_CTRL2:
+        if (v & MEAS_START_SAR) {
+            return (v & ~MEAS_DATA_SAR_MASK) | MEAS_DONE_SAR | (s->sar2_data & MEAS_DATA_SAR_MASK);
+        }
+        return v & ~(MEAS_DONE_SAR | MEAS_DATA_SAR_MASK);
+    case R_SAR_TSENS_CTRL:
+        s->tsens_reads++;
+        return (v & ~TSENS_OUT_MASK) | TSENS_READY | (s->tsens_out & TSENS_OUT_MASK);
+    case R_SAR_COCPU_INT_ST:
+        return s->reg[R_SAR_COCPU_INT_RAW / 4] & s->reg[R_SAR_COCPU_INT_ENA / 4];
+    default:
+        return v;
+    }
+}
+
+static void esp32s3_saradc_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32S3SarAdcState *s = ESP32S3_SARADC(opaque);
+    uint32_t v = value;
+    uint32_t old = s->reg[addr / 4];
+    switch (addr) {
+    case R_SAR_MEAS1_CTRL2:
+        if ((v & MEAS_START_SAR) && !(old & MEAS_START_SAR)) {
+            s->sar1_starts++;
+            s->sar1_pad = (v >> MEAS_EN_PAD_SHIFT) & MEAS_EN_PAD_MASK;
+        }
+        break;
+    case R_SAR_MEAS2_CTRL2:
+        if ((v & MEAS_START_SAR) && !(old & MEAS_START_SAR)) {
+            s->sar2_starts++;
+            s->sar2_pad = (v >> MEAS_EN_PAD_SHIFT) & MEAS_EN_PAD_MASK;
+        }
+        break;
+    case R_SAR_COCPU_INT_CLR:
+        s->reg[R_SAR_COCPU_INT_RAW / 4] &= ~v;
+        return;
+    case R_SAR_COCPU_INT_ENA_W1TS:
+        s->reg[R_SAR_COCPU_INT_ENA / 4] |= v;
+        return;
+    case R_SAR_COCPU_INT_ENA_W1TC:
+        s->reg[R_SAR_COCPU_INT_ENA / 4] &= ~v;
+        return;
+    default:
+        break;
+    }
+    s->reg[addr / 4] = v;
+}
+
+static const MemoryRegionOps esp32s3_saradc_ops = {
+    .read = esp32s3_saradc_read,
+    .write = esp32s3_saradc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32s3_saradc_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3SarAdcState *s = ESP32S3_SARADC(obj);
+    memset(s->reg, 0, sizeof(s->reg));
+    s->reg[0x104 / 4] = 0;   /* SAR_PERI_CLK_GATE_CONF: gates closed until the firmware opens them */
+}
+
+static void esp32s3_saradc_init(Object *obj)
+{
+    ESP32S3SarAdcState *s = ESP32S3_SARADC(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32s3_saradc_ops, s, TYPE_ESP32S3_SARADC, ESP32S3_SENS_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static Property esp32s3_saradc_properties[] = {
+    DEFINE_PROP_UINT32("sar1-data", ESP32S3SarAdcState, sar1_data, 2048),
+    DEFINE_PROP_UINT32("sar2-data", ESP32S3SarAdcState, sar2_data, 2048),
+    DEFINE_PROP_UINT32("tsens-out", ESP32S3SarAdcState, tsens_out, 104),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32s3_saradc_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = esp32s3_saradc_reset_hold;
+    device_class_set_props(dc, esp32s3_saradc_properties);
+}
+
+static const TypeInfo esp32s3_saradc_info = {
+    .name = TYPE_ESP32S3_SARADC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3SarAdcState),
+    .instance_init = esp32s3_saradc_init,
+    .class_init = esp32s3_saradc_class_init,
+};
+
+static void esp32s3_saradc_register_types(void)
+{
+    type_register_static(&esp32s3_saradc_info);
+}
+
+type_init(esp32s3_saradc_register_types)
