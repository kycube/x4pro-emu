diff --git a/hw/xtensa/xteink_x4pro.c b/hw/xtensa/xteink_x4pro.c
new file mode 100644
index 0000000..6e7b113
--- /dev/null
+++ b/hw/xtensa/xteink_x4pro.c
@@ -0,0 +1,166 @@
+/*
+ * Xteink X4 Pro board: ESP32-S3R8 + 800x480 e-paper (SSD1677 / UC8179 / UC8279)
+ * + GT911 touch + BM8563 RTC + CW2017 gauge + buttons.
+ *
+ * The machine is a QOM subclass of Espressif's "esp32s3" machine. It calls the
+ * parent init (which builds the whole SoC) and then adds the board devices.
+ * Stub SoC peripherals are shadowed by mapping full models at the same base
+ * with a higher memory-region priority, so esp32s3.c is not edited.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "hw/boards.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "exec/memory.h"
+#include "exec/address-spaces.h"
+#include "hw/misc/esp32s3_reg.h"
+#include "hw/xtensa/esp32s3_intc.h"
+#include "hw/misc/esp32s3_usj.h"
+
+#define TYPE_ESP32S3_MACHINE MACHINE_TYPE_NAME("esp32s3")
+#define TYPE_X4PRO_MACHINE   MACHINE_TYPE_NAME("xteink-x4pro")
+
+typedef struct X4ProMachineClass {
+    MachineClass parent_class;
+    void (*parent_init)(MachineState *machine);
+} X4ProMachineClass;
+
+DECLARE_CLASS_CHECKERS(X4ProMachineClass, X4PRO_MACHINE, TYPE_X4PRO_MACHINE)
+
+/* ---- I/O access logger for peripheral blocks we do not model yet ---------
+ * The stock SoC covers 0x60000000..0x600d1000 with a silent catch-all, so
+ * `-d unimp` never sees a peripheral access. These overlays (priority 1) log
+ * every access to the named block and return 0, which is exactly what the
+ * catch-all did, but visibly. Real models replace them one by one.
+ */
+typedef struct IoLogRegion {
+    const char *name;
+    hwaddr base;
+    uint32_t size;
+    MemoryRegion mr;
+} IoLogRegion;
+
+static IoLogRegion iolog_regions[] = {
+    { "gpio",      DR_REG_GPIO_BASE,            0x1000 },
+    { "rtcio",     DR_REG_RTCIO_BASE,           0x400  },
+    { "iomux",     DR_REG_IO_MUX_BASE,          0x1000 },
+    { "i2c0",      DR_REG_I2C_EXT_BASE,         0x1000 },
+    { "ledc",      DR_REG_LEDC_BASE,            0x1000 },
+    { "spi2",      DR_REG_SPI2_BASE,            0x1000 },
+    { "spi3",      DR_REG_SPI3_BASE,            0x1000 },
+    { "usb_wrap",  DR_REG_USB_WRAP_BASE,        0x1000 },
+    { "rmt",       DR_REG_RMT_BASE,             0x1000 },
+    { "sens",      0x60008800,                  0x400  },
+    { "apb_saradc",0x60040000,                  0x1000 },
+    { "pcnt",      0x60017000,                  0x1000 },
+    { "mcpwm0",    0x6001E000,                  0x1000 },
+    { "i2c1",      0x60027000,                  0x1000 },
+    { "uhci0",     0x60014000,                  0x1000 },
+    { "i2s0",      0x6000F000,                  0x1000 },
+    { "i2s1",      0x6002D000,                  0x1000 },
+    { "lcd_cam",   0x60041000,                  0x1000 },
+    { "usb_otg",   0x60080000,                  0x40000 },
+};
+
+static uint32_t x4pro_strap_mode = 0x4;   /* SPI flash boot; copied from /machine/soc/gpio */
+
+static uint64_t iolog_read(void *opaque, hwaddr addr, unsigned size)
+{
+    IoLogRegion *r = opaque;
+    if (r->base == DR_REG_GPIO_BASE && addr == 0x38) {
+        return x4pro_strap_mode;   /* GPIO_STRAP_REG: keep the SoC stub's answer */
+    }
+    qemu_log_mask(LOG_UNIMP, "x4pro/%s: read  0x%08" HWADDR_PRIx " size %u\n",
+                  r->name, r->base + addr, size);
+    return 0;
+}
+
+static void iolog_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    IoLogRegion *r = opaque;
+    qemu_log_mask(LOG_UNIMP, "x4pro/%s: write 0x%08" HWADDR_PRIx " = 0x%08" PRIx64 " size %u\n",
+                  r->name, r->base + addr, value, size);
+}
+
+static const MemoryRegionOps iolog_ops = {
+    .read = iolog_read,
+    .write = iolog_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void x4pro_add_iolog(MachineState *machine, MemoryRegion *sys_mem)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(iolog_regions); i++) {
+        IoLogRegion *r = &iolog_regions[i];
+        char name[32];
+        snprintf(name, sizeof(name), "x4pro.iolog.%s", r->name);
+        memory_region_init_io(&r->mr, OBJECT(machine), &iolog_ops, r, name, r->size);
+        memory_region_add_subregion_overlap(sys_mem, r->base, &r->mr, 1);
+    }
+}
+
+/* ---- machine ------------------------------------------------------------ */
+
+static void x4pro_machine_init(MachineState *machine)
+{
+    X4ProMachineClass *xc = X4PRO_MACHINE_GET_CLASS(machine);
+    MemoryRegion *sys_mem = get_system_memory();
+
+    /* Build the stock ESP32-S3 SoC first. */
+    xc->parent_init(machine);
+
+    DeviceState *intmatrix = DEVICE(object_resolve_path("/machine/soc/intmatrix", NULL));
+    if (!intmatrix) {
+        error_report("xteink-x4pro: cannot find /machine/soc/intmatrix");
+        exit(1);
+    }
+
+    /* USB Serial/JTAG console, shadowing the SoC's stub at the same base. */
+    {
+        DeviceState *usj = qdev_new(TYPE_ESP32S3_USJ);
+        object_property_add_child(OBJECT(machine), "usj", OBJECT(usj));
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(usj), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(usj), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_USB_SERIAL_JTAG_BASE, mr, 1);
+        sysbus_connect_irq(SYS_BUS_DEVICE(usj), 0,
+                           qdev_get_gpio_in(intmatrix, ETS_USB_SERIAL_JTAG_INTR_SOURCE));
+    }
+
+    {
+        Object *gpio = object_resolve_path("/machine/soc/gpio", NULL);
+        if (gpio) {
+            x4pro_strap_mode = object_property_get_int(gpio, "strap_mode", &error_abort);
+        }
+    }
+    x4pro_add_iolog(machine, sys_mem);
+}
+
+static void x4pro_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    X4ProMachineClass *xc = X4PRO_MACHINE_CLASS(oc);
+
+    xc->parent_init = mc->init;   /* inherited esp32s3 init */
+    mc->init = x4pro_machine_init;
+    mc->desc = "Xteink X4 Pro e-reader (ESP32-S3R8, 800x480 EPD, GT911)";
+}
+
+static const TypeInfo x4pro_machine_info = {
+    .name = TYPE_X4PRO_MACHINE,
+    .parent = TYPE_ESP32S3_MACHINE,
+    .class_size = sizeof(X4ProMachineClass),
+    .class_init = x4pro_machine_class_init,
+};
+
+static void x4pro_machine_type_init(void)
+{
+    type_register_static(&x4pro_machine_info);
+}
+
+type_init(x4pro_machine_type_init);
diff --git a/include/hw/misc/esp32s3_usj.h b/include/hw/misc/esp32s3_usj.h
new file mode 100644
index 0000000..a7e090c
--- /dev/null
+++ b/include/hw/misc/esp32s3_usj.h
@@ -0,0 +1,46 @@
+/*
+ * ESP32-S3 USB Serial/JTAG controller: the CDC-ACM half, modelled as a
+ * chardev-backed console. Enough of the register interface for ESP-IDF's
+ * usb_serial_jtag driver and Arduino's HWCDC to believe a host is attached.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "chardev/char-fe.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32S3_USJ "esp32s3.usj"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3UsjState, ESP32S3_USJ)
+
+#define ESP32S3_USJ_REGS_SIZE 0x84
+#define ESP32S3_USJ_PKT 64
+
+struct ESP32S3UsjState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    CharBackend chr;
+    QEMUTimer *sof_timer;
+
+    /* properties */
+    bool host_connected;     /* generate SOF, accept IN packets */
+
+    uint32_t int_raw;
+    uint32_t int_ena;
+    uint32_t conf0;
+    uint32_t fram_num;
+
+    uint8_t tx[ESP32S3_USJ_PKT];
+    uint32_t tx_len;
+    uint8_t rx[ESP32S3_USJ_PKT];
+    uint32_t rx_len;
+    uint32_t rx_pos;
+
+    /* statistics for the board state property */
+    uint64_t tx_bytes;
+    uint64_t rx_bytes;
+    uint64_t flushes;
+};
-- 
