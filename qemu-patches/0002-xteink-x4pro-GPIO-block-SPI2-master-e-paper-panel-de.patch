diff --git a/hw/display/x4pro_epd.c b/hw/display/x4pro_epd.c
new file mode 100644
index 0000000..f33f21c
--- /dev/null
+++ b/hw/display/x4pro_epd.c
@@ -0,0 +1,270 @@
+/*
+ * Xteink X4 Pro e-paper panel device (glue around models/epd_core.c).
+ *
+ * Byte path: SPI2 -> SSIBus -> transfer() -> epd_core_byte() gated by the CS
+ * and DC levels that the firmware drives with plain GPIOs.
+ * Probe path: the firmware bit-bangs SCLK/MOSI; we watch those pins and feed
+ * the core's bit-bang decoder; a UC part answers on the shared line, which we
+ * drive back into the GPIO model's external input for the MOSI pad.
+ * BUSY: after any command that makes the core request a BUSY interval, a
+ * guest-time timer keeps BUSY asserted for that long (2 ms with fast-epd).
+ * Display: a QemuConsole surface (800x480 xRGB) refreshed from the core's
+ * image after each refresh, so `screendump device=epd` works headless.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "ui/pixel_ops.h"
+#include "hw/display/x4pro_epd.h"
+
+static void epd_trace(void *opaque, uint8_t cmd, const uint8_t *data, size_t len, bool truncated)
+{
+    X4ProEpdState *s = opaque;
+    if (!s->trace) {
+        return;
+    }
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    fprintf(s->trace, "{\"t_us\":%" PRId64 ",\"cmd\":\"0x%02x\",\"len\":%u,\"data\":\"",
+            now / 1000, cmd, (unsigned)s->core.cmd_len);
+    size_t n = len < 16 ? len : 16;
+    for (size_t i = 0; i < n; i++) {
+        fprintf(s->trace, "%s%02x", i ? " " : "", data[i]);
+    }
+    fprintf(s->trace, "\"%s}\n", (truncated || len > 16) ? ",\"more\":true" : "");
+    fflush(s->trace);
+}
+
+static void epd_apply_busy(X4ProEpdState *s)
+{
+    EpdCore *c = &s->core;
+    if (c->busy_request_us) {
+        uint32_t us = s->fast_epd ? 2000 : c->busy_request_us;
+        c->busy_request_us = 0;
+        s->busy_intervals++;
+        timer_mod(s->busy_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (int64_t)us * 1000);
+    }
+    /* SSD1677: busy = HIGH. UC81xx: BUSY_N idle HIGH, busy LOW. */
+    int level = (c->variant == EPD_SSD1677) ? (c->busy ? 1 : 0) : (c->busy ? 0 : 1);
+    qemu_set_irq(s->busy_out, level);
+}
+
+static void epd_update_display(X4ProEpdState *s)
+{
+    if (!s->con || !s->core.image_dirty) {
+        return;
+    }
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    if (!surface) {
+        return;
+    }
+    uint32_t *dst = surface_data(surface);
+    const uint8_t *src = s->core.image;
+    for (int i = 0; i < EPD_W * EPD_H; i++) {
+        uint8_t v = src[i];
+        dst[i] = 0xFF000000u | (v << 16) | (v << 8) | v;
+    }
+    dpy_gfx_update_full(s->con);
+    s->core.image_dirty = false;
+}
+
+static void epd_busy_timeout(void *opaque)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    epd_core_busy_done(&s->core);
+    epd_apply_busy(s);
+}
+
+static void epd_after_byte(X4ProEpdState *s)
+{
+    if (s->core.image_dirty) {
+        s->last_refresh_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        epd_update_display(s);
+    }
+    epd_apply_busy(s);
+}
+
+static uint32_t epd_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    X4ProEpdState *s = X4PRO_EPD(dev);
+    epd_core_byte(&s->core, val & 0xFF);
+    epd_after_byte(s);
+    return 0xFF;   /* no MISO */
+}
+
+static void epd_set_line(X4ProEpdState *s)
+{
+    int lvl = epd_core_line_level(&s->core);
+    int out = (lvl < 0) ? 2 : lvl;
+    if (out != s->line_driven) {
+        s->line_driven = out;
+        qemu_set_irq(s->line_out, out);
+    }
+}
+
+static void epd_gpio_cs(void *opaque, int n, int level)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    epd_core_set_cs(&s->core, level == 0);
+    epd_set_line(s);
+}
+
+static void epd_gpio_dc(void *opaque, int n, int level)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    epd_core_set_dc(&s->core, level != 0);
+    epd_set_line(s);
+}
+
+static void epd_gpio_rst(void *opaque, int n, int level)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    epd_core_set_rst(&s->core, level != 0);
+    epd_after_byte(s);
+    epd_set_line(s);
+}
+
+static void epd_gpio_sclk(void *opaque, int n, int level)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    if (level) {
+        epd_core_sclk_rise(&s->core, s->mosi_level);
+        epd_after_byte(s);
+    } else {
+        epd_core_sclk_fall(&s->core);
+    }
+    epd_set_line(s);
+}
+
+static void epd_gpio_mosi(void *opaque, int n, int level)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    s->mosi_level = level;
+}
+
+static void epd_invalidate(void *opaque)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    s->core.image_dirty = true;
+    epd_update_display(s);
+}
+
+static void epd_gfx_update(void *opaque)
+{
+    X4ProEpdState *s = X4PRO_EPD(opaque);
+    epd_update_display(s);
+}
+
+static const GraphicHwOps epd_gfx_ops = {
+    .invalidate = epd_invalidate,
+    .gfx_update = epd_gfx_update,
+};
+
+const EpdCore *x4pro_epd_core(X4ProEpdState *s)
+{
+    return &s->core;
+}
+
+static void epd_realize(SSIPeripheral *dev, Error **errp)
+{
+    X4ProEpdState *s = X4PRO_EPD(dev);
+    EpdVariant v = EPD_UC8279;   /* the desk unit's controller (docs/device/boot-crosspoint-1.6.0.log) */
+    if (s->panel) {
+        if (!strcmp(s->panel, "uc8179")) v = EPD_UC8179;
+        else if (!strcmp(s->panel, "uc8279")) v = EPD_UC8279;
+        else if (!strcmp(s->panel, "ssd1677")) v = EPD_SSD1677;
+        else {
+            error_setg(errp, "x4pro.epd: unknown panel '%s' (ssd1677|uc8179|uc8279)", s->panel);
+            return;
+        }
+    }
+    epd_core_init(&s->core, v);
+    if (s->full_ms) s->core.timing.full_us = s->full_ms * 1000;
+    if (s->fast_ms) s->core.timing.fast_us = s->fast_ms * 1000;
+    if (s->half_ms) s->core.timing.half_us = s->half_ms * 1000;
+    if (s->gray_ms) s->core.timing.gray_us = s->gray_ms * 1000;
+    if (s->power_ms) s->core.timing.power_us = s->power_ms * 1000;
+    s->core.trace = epd_trace;
+    s->core.trace_opaque = s;
+    if (s->trace_path && s->trace_path[0]) {
+        s->trace = fopen(s->trace_path, "w");
+        if (!s->trace) {
+            error_setg(errp, "x4pro.epd: cannot open trace file %s", s->trace_path);
+            return;
+        }
+    }
+    s->busy_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, epd_busy_timeout, s);
+    s->line_driven = 2;
+    s->mosi_level = 1;
+    s->con = graphic_console_init(DEVICE(dev), 0, &epd_gfx_ops, s);
+    qemu_console_resize(s->con, EPD_W, EPD_H);
+    s->core.image_dirty = true;
+    epd_update_display(s);
+}
+
+static void epd_reset_hold(Object *obj, ResetType type)
+{
+    X4ProEpdState *s = X4PRO_EPD(obj);
+    /* A system reset does not power-cycle the panel; keep RAM and the image. */
+    s->core.cs = false;
+    s->core.cmd = -1;
+    epd_apply_busy(s);
+}
+
+static void epd_init(Object *obj)
+{
+    X4ProEpdState *s = X4PRO_EPD(obj);
+    DeviceState *dev = DEVICE(obj);
+    qdev_init_gpio_in_named(dev, epd_gpio_cs, X4PRO_EPD_GPIO_CS, 1);
+    qdev_init_gpio_in_named(dev, epd_gpio_dc, X4PRO_EPD_GPIO_DC, 1);
+    qdev_init_gpio_in_named(dev, epd_gpio_rst, X4PRO_EPD_GPIO_RST, 1);
+    qdev_init_gpio_in_named(dev, epd_gpio_sclk, X4PRO_EPD_GPIO_SCLK, 1);
+    qdev_init_gpio_in_named(dev, epd_gpio_mosi, X4PRO_EPD_GPIO_MOSI, 1);
+    qdev_init_gpio_out_named(dev, &s->busy_out, X4PRO_EPD_GPIO_BUSY, 1);
+    qdev_init_gpio_out_named(dev, &s->line_out, X4PRO_EPD_GPIO_LINE, 1);
+}
+
+static Property epd_properties[] = {
+    DEFINE_PROP_STRING("panel", X4ProEpdState, panel),
+    DEFINE_PROP_BOOL("fast-epd", X4ProEpdState, fast_epd, false),
+    DEFINE_PROP_STRING("trace-epd", X4ProEpdState, trace_path),
+    /* 0 = the core's per-variant default measured on the device */
+    DEFINE_PROP_UINT32("full-ms", X4ProEpdState, full_ms, 0),
+    DEFINE_PROP_UINT32("fast-ms", X4ProEpdState, fast_ms, 0),
+    DEFINE_PROP_UINT32("half-ms", X4ProEpdState, half_ms, 0),
+    DEFINE_PROP_UINT32("gray-ms", X4ProEpdState, gray_ms, 0),
+    DEFINE_PROP_UINT32("power-ms", X4ProEpdState, power_ms, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void epd_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    k->realize = epd_realize;
+    k->transfer = epd_transfer;
+    k->cs_polarity = SSI_CS_NONE;   /* CS is a plain GPIO on this board */
+    rc->phases.hold = epd_reset_hold;
+    device_class_set_props(dc, epd_properties);
+    dc->desc = "Xteink X4 Pro e-paper panel";
+}
+
+static const TypeInfo epd_info = {
+    .name = TYPE_X4PRO_EPD,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(X4ProEpdState),
+    .instance_init = epd_init,
+    .class_init = epd_class_init,
+};
+
+static void epd_register_types(void)
+{
+    type_register_static(&epd_info);
+}
+
+type_init(epd_register_types)
