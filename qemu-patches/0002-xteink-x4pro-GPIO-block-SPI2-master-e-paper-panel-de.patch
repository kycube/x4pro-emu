diff --git a/hw/ssi/esp32s3_gpspi.c b/hw/ssi/esp32s3_gpspi.c
new file mode 100644
index 0000000..28b95c6
--- /dev/null
+++ b/hw/ssi/esp32s3_gpspi.c
@@ -0,0 +1,254 @@
+/*
+ * ESP32-S3 GP-SPI master (SPI2 at 0x60024000, SPI3 at 0x60025000).
+ *
+ * Register map from ESP-IDF v5.5 soc/spi_reg.h (docs/audit.md). Only the
+ * CPU-driven (non-DMA) path is modelled, which is what the Arduino SPIClass
+ * uses: the driver fills W0..W15, sets MS_DLEN, pulses CMD.UPDATE, then sets
+ * CMD.USR. We then clock (MS_DLEN+1)/8 bytes out onto the SSIBus (and, if
+ * USR_MISO is set, store what comes back into W0..), clear USR and raise
+ * TRANS_DONE. Clock, timing and mode registers are stored but ignored. The
+ * peripheral's own CS outputs are provided but the X4 Pro firmware drives its
+ * chip select with a plain GPIO.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/esp32s3_gpspi.h"
+
+#define R_CMD          0x00
+#define R_ADDR         0x04
+#define R_CTRL         0x08
+#define R_CLOCK        0x0C
+#define R_USER         0x10
+#define R_USER1        0x14
+#define R_USER2        0x18
+#define R_MS_DLEN      0x1C
+#define R_MISC         0x20
+#define R_DIN_MODE     0x24
+#define R_DIN_NUM      0x28
+#define R_DOUT_MODE    0x2C
+#define R_DMA_CONF     0x30
+#define R_DMA_INT_ENA  0x34
+#define R_DMA_INT_CLR  0x38
+#define R_DMA_INT_RAW  0x3C
+#define R_DMA_INT_ST   0x40
+#define R_DMA_INT_SET  0x44
+#define R_W0           0x98
+#define R_W15          0xD4
+#define R_SLAVE        0xE0
+#define R_SLAVE1       0xE4
+#define R_CLK_GATE     0xE8
+#define R_DATE         0xF0
+
+#define CMD_USR        (1u << 24)
+#define CMD_UPDATE     (1u << 23)
+
+#define USER_COMMAND   (1u << 31)
+#define USER_ADDR      (1u << 30)
+#define USER_DUMMY     (1u << 29)
+#define USER_MISO      (1u << 28)
+#define USER_MOSI      (1u << 27)
+#define USER_MOSI_HIGHPART (1u << 25)
+#define USER_MISO_HIGHPART (1u << 24)
+
+#define INT_TRANS_DONE (1u << 12)
+
+static void gpspi_update_irq(ESP32S3GpSpiState *s)
+{
+    qemu_set_irq(s->irq, (s->dma_int_raw & s->dma_int_ena) != 0);
+}
+
+static void gpspi_cs_set(ESP32S3GpSpiState *s, int active)
+{
+    /* MISC bits 0..5: CSn_DIS. An enabled CS follows the transaction (active low). */
+    for (int i = 0; i < ESP32S3_GPSPI_CS_COUNT; i++) {
+        bool enabled = !((s->misc >> i) & 1);
+        qemu_set_irq(s->cs_gpio[i], enabled ? !active : 1);
+    }
+}
+
+static void gpspi_do_user_transfer(ESP32S3GpSpiState *s)
+{
+    gpspi_cs_set(s, 1);
+    if (s->user & USER_COMMAND) {
+        int bits = ((s->user2 >> 28) & 0xF) + 1;
+        uint32_t cmd = s->user2 & 0xFFFF;
+        for (int b = 0; b < (bits + 7) / 8; b++) {
+            ssi_transfer(s->spi, (cmd >> (8 * b)) & 0xFF);   /* LSB-first byte order as the hw sends */
+            s->bytes_out++;
+        }
+    }
+    if (s->user & USER_ADDR) {
+        int bits = ((s->user1 >> 27) & 0x1F) + 1;
+        int bytes = (bits + 7) / 8;
+        uint32_t addr = s->addr;
+        for (int b = bytes - 1; b >= 0; b--) {
+            ssi_transfer(s->spi, (addr >> (8 * b)) & 0xFF);
+            s->bytes_out++;
+        }
+    }
+    bool mosi = s->user & USER_MOSI;
+    bool miso = s->user & USER_MISO;
+    if (mosi || miso) {
+        int bits = (s->ms_dlen & 0x3FFFF) + 1;
+        int bytes = (bits + 7) / 8;
+        if (bytes > ESP32S3_GPSPI_BUF_WORDS * 4) {
+            bytes = ESP32S3_GPSPI_BUF_WORDS * 4;
+        }
+        uint8_t *buf = (uint8_t *)s->data_buf;
+        int off = (mosi && (s->user & USER_MOSI_HIGHPART)) ? 32 : 0;
+        for (int i = 0; i < bytes; i++) {
+            uint8_t out = mosi ? buf[(off + i) & 63] : 0;
+            uint32_t in = ssi_transfer(s->spi, out);
+            if (miso) {
+                buf[(off + i) & 63] = in & 0xFF;
+            }
+            s->bytes_out++;
+        }
+    }
+    gpspi_cs_set(s, 0);
+    s->transfers++;
+    s->dma_int_raw |= INT_TRANS_DONE;
+    gpspi_update_irq(s);
+}
+
+static uint64_t gpspi_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(opaque);
+    uint32_t r = 0;
+    switch (addr) {
+    case R_CMD:        r = 0; break;                 /* USR and UPDATE self-clear at once */
+    case R_ADDR:       r = s->addr; break;
+    case R_CTRL:       r = s->ctrl; break;
+    case R_CLOCK:      r = s->clock; break;
+    case R_USER:       r = s->user; break;
+    case R_USER1:      r = s->user1; break;
+    case R_USER2:      r = s->user2; break;
+    case R_MS_DLEN:    r = s->ms_dlen; break;
+    case R_MISC:       r = s->misc; break;
+    case R_DIN_MODE:   r = s->din_mode; break;
+    case R_DIN_NUM:    r = s->din_num; break;
+    case R_DOUT_MODE:  r = s->dout_mode; break;
+    case R_DMA_CONF:   r = s->dma_conf; break;
+    case R_DMA_INT_ENA: r = s->dma_int_ena; break;
+    case R_DMA_INT_RAW: r = s->dma_int_raw; break;
+    case R_DMA_INT_ST:  r = s->dma_int_raw & s->dma_int_ena; break;
+    case R_SLAVE:      r = s->slave; break;
+    case R_SLAVE1:     r = s->slave1; break;
+    case R_CLK_GATE:   r = s->clk_gate; break;
+    case R_DATE:       r = 0x2101040; break;
+    default:
+        if (addr >= R_W0 && addr <= R_W15) {
+            r = s->data_buf[(addr - R_W0) / 4];
+        } else {
+            qemu_log_mask(LOG_UNIMP, "esp32s3.gpspi: unhandled read +0x%" HWADDR_PRIx "\n", addr);
+        }
+    }
+    return r;
+}
+
+static void gpspi_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(opaque);
+    uint32_t v = value;
+    switch (addr) {
+    case R_CMD:
+        if (v & CMD_USR) {
+            gpspi_do_user_transfer(s);
+        }
+        break;
+    case R_ADDR:       s->addr = v; break;
+    case R_CTRL:       s->ctrl = v; break;
+    case R_CLOCK:      s->clock = v; break;
+    case R_USER:       s->user = v; break;
+    case R_USER1:      s->user1 = v; break;
+    case R_USER2:      s->user2 = v; break;
+    case R_MS_DLEN:    s->ms_dlen = v; break;
+    case R_MISC:       s->misc = v; break;
+    case R_DIN_MODE:   s->din_mode = v; break;
+    case R_DIN_NUM:    s->din_num = v; break;
+    case R_DOUT_MODE:  s->dout_mode = v; break;
+    case R_DMA_CONF:   s->dma_conf = v; break;
+    case R_DMA_INT_ENA: s->dma_int_ena = v; gpspi_update_irq(s); break;
+    case R_DMA_INT_CLR: s->dma_int_raw &= ~v; gpspi_update_irq(s); break;
+    case R_DMA_INT_SET: s->dma_int_raw |= v; gpspi_update_irq(s); break;
+    case R_DMA_INT_RAW: break;
+    case R_SLAVE:      s->slave = v; break;
+    case R_SLAVE1:     s->slave1 = v; break;
+    case R_CLK_GATE:   s->clk_gate = v; break;
+    default:
+        if (addr >= R_W0 && addr <= R_W15) {
+            s->data_buf[(addr - R_W0) / 4] = v;
+        } else {
+            qemu_log_mask(LOG_UNIMP, "esp32s3.gpspi: unhandled write +0x%" HWADDR_PRIx " = 0x%x\n", addr, v);
+        }
+    }
+}
+
+static const MemoryRegionOps gpspi_ops = {
+    .read = gpspi_read,
+    .write = gpspi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void gpspi_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(obj);
+    s->addr = 0;
+    s->ctrl = 0x3C0000;
+    s->clock = 0x80003043;
+    s->user = 0x800000C0;
+    s->user1 = 0xB8410007;
+    s->user2 = 0x70000000;
+    s->ms_dlen = 0;
+    s->misc = 0x3E;          /* CS1..CS5 disabled, CS0 enabled */
+    s->dma_conf = 0;
+    s->dma_int_ena = 0;
+    s->dma_int_raw = 0;
+    s->slave = 0;
+    s->slave1 = 0;
+    s->clk_gate = 0;
+    memset(s->data_buf, 0, sizeof(s->data_buf));
+    gpspi_cs_set(s, 0);
+}
+
+static void gpspi_init(Object *obj)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &gpspi_ops, s, TYPE_ESP32S3_GPSPI, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->spi = ssi_create_bus(DEVICE(s), "spi");
+    qdev_init_gpio_out_named(DEVICE(s), s->cs_gpio, SSI_GPIO_CS, ESP32S3_GPSPI_CS_COUNT);
+}
+
+static void gpspi_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = gpspi_reset_hold;
+}
+
+static const TypeInfo gpspi_info = {
+    .name = TYPE_ESP32S3_GPSPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3GpSpiState),
+    .instance_init = gpspi_init,
+    .class_init = gpspi_class_init,
+};
+
+static void gpspi_register_types(void)
+{
+    type_register_static(&gpspi_info);
+}
+
+type_init(gpspi_register_types)
