+static const int btn_pin[3] = { PIN_BTN_LEFT, PIN_BTN_RIGHT, PIN_BTN_POWER };
+static const char *btn_name[3] = { "btn-left", "btn-right", "btn-power" };
+
+static void x4pro_input_apply(X4ProInputState *s)
+{
+    if (!s->gpio) {
+        return;
+    }
+    for (int i = 0; i < 3; i++) {
+        /* active-low with pull-up: pressed drives 0, released floats to the idle 1 */
+        qemu_set_irq(qdev_get_gpio_in_named(DEVICE(s->gpio), ESP32S3_GPIO_PIN_IN, btn_pin[i]),
+                     s->btn[i] ? 0 : ESP32S3_GPIO_RELEASE);
+    }
+    /* charger STAT: input, no pull, HIGH = charging */
+    qemu_set_irq(qdev_get_gpio_in_named(DEVICE(s->gpio), ESP32S3_GPIO_PIN_IN, PIN_CHG_STAT),
