+/*
+ * Xteink X4 Pro e-paper panel as a QEMU device: SSI peripheral on SPI2 plus
+ * raw GPIO edges (CS/DC/RST/SCLK/MOSI) for the bit-banged probe, BUSY output,
+ * and a graphic console for screendump.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/ssi/ssi.h"
+#include "qemu/timer.h"
+#include "ui/console.h"
+#include "hw/display/epd_core.h"
+
+#define TYPE_X4PRO_EPD "x4pro.epd"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProEpdState, X4PRO_EPD)
+
+/* named GPIO inputs */
+#define X4PRO_EPD_GPIO_CS   "cs"
+#define X4PRO_EPD_GPIO_DC   "dc"
+#define X4PRO_EPD_GPIO_RST  "rst"
+#define X4PRO_EPD_GPIO_SCLK "sclk"
+#define X4PRO_EPD_GPIO_MOSI "mosi"
+/* named GPIO outputs */
+#define X4PRO_EPD_GPIO_BUSY "busy"          /* level as the controller drives it */
+#define X4PRO_EPD_GPIO_LINE "line"          /* driven level on the shared data line, 2 = released */
+
+struct X4ProEpdState {
+    SSIPeripheral parent_obj;
+
+    EpdCore core;
+    QEMUTimer *busy_timer;
+    QemuConsole *con;
+    qemu_irq busy_out;
+    qemu_irq line_out;
+    int mosi_level;
+    int line_driven;      /* last value sent on line_out */
+
+    /* properties */
+    char *panel;          /* "ssd1677" | "uc8179" | "uc8279" */
+    bool fast_epd;        /* 2 ms refreshes */
+    char *trace_path;
+    uint32_t full_ms, fast_ms, half_ms, gray_ms, power_ms;
+
+    FILE *trace;
+    uint64_t busy_intervals;
+    int64_t last_refresh_ns;
+};
+
+const EpdCore *x4pro_epd_core(X4ProEpdState *s);
diff --git a/include/hw/gpio/esp32s3_gpio_full.h b/include/hw/gpio/esp32s3_gpio_full.h
new file mode 100644
index 0000000..a6f5cf7
--- /dev/null
+++ b/include/hw/gpio/esp32s3_gpio_full.h
@@ -0,0 +1,50 @@
+/*
+ * ESP32-S3 GPIO block: OUT/ENABLE/IN/STATUS/PINn/interrupts and per-pin
+ * external drivers, for boards that wire real devices to the pins.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_GPIO_FULL "esp32s3.gpio-full"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3GpioFullState, ESP32S3_GPIO_FULL)
+
+#define ESP32S3_GPIO_PINS 49
+#define ESP32S3_GPIO_FUNC_IN_COUNT 256
+
+/* Named GPIO lines of this device:
+ *   "pin-out"[49]: level the pad sits at (0/1), fired on every change.
+ *   "pin-in"[49] : external driver: 0/1 drives the pad, ESP32S3_GPIO_RELEASE releases it.
+ */
+#define ESP32S3_GPIO_PIN_OUT "pin-out"
+#define ESP32S3_GPIO_PIN_IN  "pin-in"
+#define ESP32S3_GPIO_RELEASE 2
+
+struct ESP32S3GpioFullState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;                          /* to the interrupt matrix (core 0) */
+    qemu_irq pin_out[ESP32S3_GPIO_PINS];
+
+    uint32_t strap_mode;
+
+    uint64_t out;        /* OUT + OUT1 */
+    uint64_t enable;     /* ENABLE + ENABLE1 */
+    uint64_t ext;        /* external driver level, valid where ext_valid */
+    uint64_t ext_valid;
+    uint64_t idle;       /* level of an undriven input (1 = pull-up) */
+    uint64_t status;     /* STATUS + STATUS1 (interrupt status) */
+    uint64_t level;      /* current pad level (cached) */
+    uint32_t pin[ESP32S3_GPIO_PINS];       /* PINn config */
+    uint32_t func_in_sel[ESP32S3_GPIO_FUNC_IN_COUNT];
+    uint32_t func_out_sel[ESP32S3_GPIO_PINS];
+    uint32_t clock_gate;
+    uint64_t irq_count;
+};
+
+/* Board helpers */
+void esp32s3_gpio_full_set_idle(ESP32S3GpioFullState *s, int pin, int level);
+int  esp32s3_gpio_full_get_level(ESP32S3GpioFullState *s, int pin);
+bool esp32s3_gpio_full_is_output(ESP32S3GpioFullState *s, int pin);
diff --git a/include/hw/ssi/esp32s3_gpspi.h b/include/hw/ssi/esp32s3_gpspi.h
