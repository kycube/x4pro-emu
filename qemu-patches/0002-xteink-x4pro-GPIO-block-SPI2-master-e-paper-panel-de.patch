diff --git a/hw/gpio/esp32s3_gpio_full.c b/hw/gpio/esp32s3_gpio_full.c
new file mode 100644
index 0000000..1ffedc8
--- /dev/null
+++ b/hw/gpio/esp32s3_gpio_full.c
@@ -0,0 +1,340 @@
+/*
+ * ESP32-S3 GPIO block. Register map from ESP-IDF v5.5 soc/gpio_reg.h
+ * (see docs/audit.md "Register offsets"):
+ *   OUT +0x04 (W1TS +0x08, W1TC +0x0C), OUT1 +0x10 (+0x14/+0x18),
+ *   ENABLE +0x20 (+0x24/+0x28), ENABLE1 +0x2C (+0x30/+0x34), STRAP +0x38,
+ *   IN +0x3C, IN1 +0x40, STATUS +0x44 (+0x48/+0x4C), STATUS1 +0x50 (+0x54/+0x58),
+ *   PCPU_INT +0x5C, PCPU_NMI_INT +0x60, CPUSDIO_INT +0x64, PCPU_INT1 +0x68,
+ *   PCPU_NMI_INT1 +0x6C, CPUSDIO_INT1 +0x70, PINn +0x74 + 4n,
+ *   STATUS_NEXT +0x14C/+0x150, FUNCn_IN_SEL_CFG +0x154 + 4n,
+ *   FUNCn_OUT_SEL_CFG +0x554 + 4n, CLOCK_GATE +0x62C, DATE +0x6FC.
+ *
+ * Electrical model: a pad's level is OUT when ENABLE is set, otherwise the
+ * external driver's level if one is attached (a board device on "pin-in"),
+ * otherwise the pin's idle level (1 for pull-ups). IN always reads the pad
+ * level. Every level change is reported on "pin-out" and evaluated against
+ * the PINn interrupt type; STATUS latches, PCPU_INT shows STATUS for pins
+ * whose INT_ENA has bit 0 (core 0), and the irq line follows PCPU_INT != 0.
+ * The GPIO matrix (FUNC_*_SEL) is stored but not modelled electrically.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/gpio/esp32s3_gpio_full.h"
+
+#define R_BT_SELECT      0x00
+#define R_OUT            0x04
+#define R_OUT_W1TS       0x08
+#define R_OUT_W1TC       0x0C
+#define R_OUT1           0x10
+#define R_OUT1_W1TS      0x14
+#define R_OUT1_W1TC      0x18
+#define R_ENABLE         0x20
+#define R_ENABLE_W1TS    0x24
+#define R_ENABLE_W1TC    0x28
+#define R_ENABLE1        0x2C
+#define R_ENABLE1_W1TS   0x30
+#define R_ENABLE1_W1TC   0x34
+#define R_STRAP          0x38
+#define R_IN             0x3C
+#define R_IN1            0x40
+#define R_STATUS         0x44
+#define R_STATUS_W1TS    0x48
+#define R_STATUS_W1TC    0x4C
+#define R_STATUS1        0x50
+#define R_STATUS1_W1TS   0x54
+#define R_STATUS1_W1TC   0x58
+#define R_PCPU_INT       0x5C
+#define R_PCPU_NMI_INT   0x60
+#define R_CPUSDIO_INT    0x64
+#define R_PCPU_INT1      0x68
+#define R_PCPU_NMI_INT1  0x6C
+#define R_CPUSDIO_INT1   0x70
+#define R_PIN0           0x74
+#define R_PIN_END        (R_PIN0 + 4 * ESP32S3_GPIO_PINS)
+#define R_STATUS_NEXT    0x14C
+#define R_STATUS_NEXT1   0x150
+#define R_FUNC_IN_SEL0   0x154
+#define R_FUNC_IN_SEL_END (R_FUNC_IN_SEL0 + 4 * ESP32S3_GPIO_FUNC_IN_COUNT)
+#define R_FUNC_OUT_SEL0  0x554
+#define R_FUNC_OUT_SEL_END (R_FUNC_OUT_SEL0 + 4 * ESP32S3_GPIO_PINS)
+#define R_CLOCK_GATE     0x62C
+#define R_DATE           0x6FC
+
+#define PIN_INT_TYPE_SHIFT 7
+#define PIN_INT_TYPE_MASK  0x7
+#define PIN_INT_ENA_SHIFT  13
+#define PIN_INT_ENA_MASK   0x1F
+
+enum { INT_DISABLE = 0, INT_POSEDGE = 1, INT_NEGEDGE = 2, INT_ANYEDGE = 3, INT_LOW = 4, INT_HIGH = 5 };
+
+#define PINMASK ((1ULL << ESP32S3_GPIO_PINS) - 1)
+
+static inline int pin_int_type(ESP32S3GpioFullState *s, int n)
+{
+    return (s->pin[n] >> PIN_INT_TYPE_SHIFT) & PIN_INT_TYPE_MASK;
+}
+
+static inline int pin_int_ena(ESP32S3GpioFullState *s, int n)
+{
+    return (s->pin[n] >> PIN_INT_ENA_SHIFT) & PIN_INT_ENA_MASK;
+}
+
+static uint64_t gpio_pcpu_int(ESP32S3GpioFullState *s)
+{
+    uint64_t r = 0;
+    for (int n = 0; n < ESP32S3_GPIO_PINS; n++) {
+        if ((s->status >> n & 1) && (pin_int_ena(s, n) & 1)) {
+            r |= 1ULL << n;
+        }
+    }
+    return r;
+}
+
+static void gpio_update_irq(ESP32S3GpioFullState *s)
+{
+    int level = gpio_pcpu_int(s) != 0;
+    qemu_set_irq(s->irq, level);
+}
+
+static uint64_t gpio_compute_level(ESP32S3GpioFullState *s)
+{
+    uint64_t driven = s->ext_valid ? ((s->ext & s->ext_valid) | (s->idle & ~s->ext_valid)) : s->idle;
+    return ((s->out & s->enable) | (driven & ~s->enable)) & PINMASK;
+}
+
+/* Recompute pad levels; report changes on pin-out and latch interrupts. */
+static void gpio_refresh(ESP32S3GpioFullState *s)
+{
+    uint64_t old = s->level;
+    uint64_t new = gpio_compute_level(s);
+    uint64_t changed = old ^ new;
+    s->level = new;
+
+    /* level-type interrupts latch whenever the level is present */
+    for (int n = 0; n < ESP32S3_GPIO_PINS; n++) {
+        int type = pin_int_type(s, n);
+        int lvl = (new >> n) & 1;
+        bool edge = (changed >> n) & 1;
+        bool fire = false;
+        switch (type) {
+        case INT_POSEDGE: fire = edge && lvl; break;
+        case INT_NEGEDGE: fire = edge && !lvl; break;
+        case INT_ANYEDGE: fire = edge; break;
+        case INT_LOW:     fire = !lvl; break;
+        case INT_HIGH:    fire = lvl; break;
+        default: break;
+        }
+        if (fire) {
+            s->status |= 1ULL << n;
+            s->irq_count++;
+        }
+    }
+    if (changed) {
+        for (int n = 0; n < ESP32S3_GPIO_PINS; n++) {
+            if ((changed >> n) & 1) {
+                qemu_set_irq(s->pin_out[n], (new >> n) & 1);
+            }
+        }
+    }
+    gpio_update_irq(s);
+}
+
+void esp32s3_gpio_full_set_idle(ESP32S3GpioFullState *s, int pin, int level)
+{
+    if (pin < 0 || pin >= ESP32S3_GPIO_PINS) {
+        return;
+    }
+    if (level) {
+        s->idle |= 1ULL << pin;
+    } else {
+        s->idle &= ~(1ULL << pin);
+    }
+    gpio_refresh(s);
+}
+
+int esp32s3_gpio_full_get_level(ESP32S3GpioFullState *s, int pin)
+{
+    return (s->level >> pin) & 1;
+}
+
+bool esp32s3_gpio_full_is_output(ESP32S3GpioFullState *s, int pin)
+{
+    return (s->enable >> pin) & 1;
+}
+
+static void gpio_pin_in_handler(void *opaque, int n, int level)
+{
+    ESP32S3GpioFullState *s = ESP32S3_GPIO_FULL(opaque);
+    uint64_t bit = 1ULL << n;
+    if (level == ESP32S3_GPIO_RELEASE) {
+        s->ext_valid &= ~bit;
+    } else {
+        s->ext_valid |= bit;
+        if (level) {
+            s->ext |= bit;
+        } else {
+            s->ext &= ~bit;
+        }
+    }
+    gpio_refresh(s);
+}
+
+static uint64_t gpio_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GpioFullState *s = ESP32S3_GPIO_FULL(opaque);
+    uint64_t r = 0;
+
+    switch (addr) {
+    case R_OUT:        r = (uint32_t)s->out; break;
+    case R_OUT1:       r = (uint32_t)(s->out >> 32); break;
+    case R_ENABLE:     r = (uint32_t)s->enable; break;
+    case R_ENABLE1:    r = (uint32_t)(s->enable >> 32); break;
+    case R_STRAP:      r = s->strap_mode; break;
+    case R_IN:         r = (uint32_t)s->level; break;
+    case R_IN1:        r = (uint32_t)(s->level >> 32); break;
+    case R_STATUS:     r = (uint32_t)s->status; break;
+    case R_STATUS1:    r = (uint32_t)(s->status >> 32); break;
+    case R_PCPU_INT:   r = (uint32_t)gpio_pcpu_int(s); break;
+    case R_PCPU_INT1:  r = (uint32_t)(gpio_pcpu_int(s) >> 32); break;
+    case R_PCPU_NMI_INT: case R_CPUSDIO_INT: case R_PCPU_NMI_INT1: case R_CPUSDIO_INT1:
+    case R_OUT_W1TS: case R_OUT_W1TC: case R_OUT1_W1TS: case R_OUT1_W1TC:
+    case R_ENABLE_W1TS: case R_ENABLE_W1TC: case R_ENABLE1_W1TS: case R_ENABLE1_W1TC:
+    case R_STATUS_W1TS: case R_STATUS_W1TC: case R_STATUS1_W1TS: case R_STATUS1_W1TC:
+        r = 0; break;
+    case R_STATUS_NEXT: case R_STATUS_NEXT1:
+        r = 0; break;
+    case R_CLOCK_GATE: r = s->clock_gate; break;
+    case R_DATE:       r = 0x2006130; break;
+    default:
+        if (addr >= R_PIN0 && addr < R_PIN_END) {
+            r = s->pin[(addr - R_PIN0) / 4];
+        } else if (addr >= R_FUNC_IN_SEL0 && addr < R_FUNC_IN_SEL_END) {
+            r = s->func_in_sel[(addr - R_FUNC_IN_SEL0) / 4];
+        } else if (addr >= R_FUNC_OUT_SEL0 && addr < R_FUNC_OUT_SEL_END) {
+            r = s->func_out_sel[(addr - R_FUNC_OUT_SEL0) / 4];
+        } else {
+            qemu_log_mask(LOG_UNIMP, "esp32s3.gpio: unhandled read +0x%" HWADDR_PRIx "\n", addr);
+        }
+        break;
+    }
+    return r;
+}
+
+static void gpio_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3GpioFullState *s = ESP32S3_GPIO_FULL(opaque);
+    uint32_t v = value;
+    const uint64_t hi_mask = 0x1FFFFULL << 32;   /* pins 32..48 */
+
+    switch (addr) {
+    case R_OUT:         s->out = (s->out & hi_mask) | v; break;
+    case R_OUT_W1TS:    s->out |= v; break;
+    case R_OUT_W1TC:    s->out &= ~(uint64_t)v; break;
+    case R_OUT1:        s->out = (s->out & 0xFFFFFFFFULL) | ((uint64_t)(v & 0x1FFFF) << 32); break;
+    case R_OUT1_W1TS:   s->out |= (uint64_t)(v & 0x1FFFF) << 32; break;
+    case R_OUT1_W1TC:   s->out &= ~((uint64_t)(v & 0x1FFFF) << 32); break;
+    case R_ENABLE:      s->enable = (s->enable & hi_mask) | v; break;
+    case R_ENABLE_W1TS: s->enable |= v; break;
+    case R_ENABLE_W1TC: s->enable &= ~(uint64_t)v; break;
+    case R_ENABLE1:     s->enable = (s->enable & 0xFFFFFFFFULL) | ((uint64_t)(v & 0x1FFFF) << 32); break;
+    case R_ENABLE1_W1TS: s->enable |= (uint64_t)(v & 0x1FFFF) << 32; break;
+    case R_ENABLE1_W1TC: s->enable &= ~((uint64_t)(v & 0x1FFFF) << 32); break;
+    case R_STATUS:      s->status = (s->status & hi_mask) | v; gpio_update_irq(s); return;
+    case R_STATUS_W1TS: s->status |= v; gpio_update_irq(s); return;
+    case R_STATUS_W1TC: s->status &= ~(uint64_t)v; gpio_update_irq(s); return;
+    case R_STATUS1:     s->status = (s->status & 0xFFFFFFFFULL) | ((uint64_t)(v & 0x1FFFF) << 32); gpio_update_irq(s); return;
+    case R_STATUS1_W1TS: s->status |= (uint64_t)(v & 0x1FFFF) << 32; gpio_update_irq(s); return;
+    case R_STATUS1_W1TC: s->status &= ~((uint64_t)(v & 0x1FFFF) << 32); gpio_update_irq(s); return;
+    case R_STRAP:       return;
+    case R_CLOCK_GATE:  s->clock_gate = v; return;
+    case R_BT_SELECT:   return;
+    default:
+        if (addr >= R_PIN0 && addr < R_PIN_END) {
+            s->pin[(addr - R_PIN0) / 4] = v;
+            gpio_refresh(s);   /* a newly enabled level interrupt may latch at once */
+            return;
+        } else if (addr >= R_FUNC_IN_SEL0 && addr < R_FUNC_IN_SEL_END) {
+            s->func_in_sel[(addr - R_FUNC_IN_SEL0) / 4] = v;
+            return;
+        } else if (addr >= R_FUNC_OUT_SEL0 && addr < R_FUNC_OUT_SEL_END) {
+            s->func_out_sel[(addr - R_FUNC_OUT_SEL0) / 4] = v;
+            return;
+        }
+        qemu_log_mask(LOG_UNIMP, "esp32s3.gpio: unhandled write +0x%" HWADDR_PRIx " = 0x%x\n", addr, v);
+        return;
+    }
+    gpio_refresh(s);
+}
+
+static const MemoryRegionOps gpio_ops = {
+    .read = gpio_read,
+    .write = gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void gpio_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3GpioFullState *s = ESP32S3_GPIO_FULL(obj);
+    s->out = 0;
+    s->enable = 0;
+    s->status = 0;
+    memset(s->pin, 0, sizeof(s->pin));
+    memset(s->func_in_sel, 0, sizeof(s->func_in_sel));
+    for (int n = 0; n < ESP32S3_GPIO_PINS; n++) {
+        s->func_out_sel[n] = 0x100;   /* SIG_GPIO_OUT_IDX */
+    }
+    s->clock_gate = 1;
+    /* external drivers (board devices) keep their state across a reset */
+    s->level = ~gpio_compute_level(s);   /* force a full report */
+    gpio_refresh(s);
+}
+
+static void gpio_init(Object *obj)
+{
+    ESP32S3GpioFullState *s = ESP32S3_GPIO_FULL(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &gpio_ops, s, TYPE_ESP32S3_GPIO_FULL, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    qdev_init_gpio_out_named(DEVICE(sbd), s->pin_out, ESP32S3_GPIO_PIN_OUT, ESP32S3_GPIO_PINS);
+    qdev_init_gpio_in_named(DEVICE(sbd), gpio_pin_in_handler, ESP32S3_GPIO_PIN_IN, ESP32S3_GPIO_PINS);
+}
+
+static Property gpio_properties[] = {
+    DEFINE_PROP_UINT32("strap_mode", ESP32S3GpioFullState, strap_mode, 0x4),
+    DEFINE_PROP_UINT64("idle", ESP32S3GpioFullState, idle, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void gpio_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = gpio_reset_hold;
+    device_class_set_props(dc, gpio_properties);
+}
+
+static const TypeInfo gpio_info = {
+    .name = TYPE_ESP32S3_GPIO_FULL,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3GpioFullState),
+    .instance_init = gpio_init,
+    .class_init = gpio_class_init,
+};
+
+static void gpio_register_types(void)
+{
+    type_register_static(&gpio_info);
+}
+
+type_init(gpio_register_types)
