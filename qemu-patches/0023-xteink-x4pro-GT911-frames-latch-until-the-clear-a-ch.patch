+            "\"input_seq\":%" PRIu64 ",\"read_seq\":%" PRIu64 ",\"pending\":%s,\"deferred\":%" PRIu64 "},",
+            b->gt911->frame_ready ? "true" : "false", b->gt911->frames, b->gt911->clears, b->gt911->start_nacks, b->gt911->key_reads,
+            b->gt911->input_seq, b->gt911->read_seq, b->gt911->pending ? "true" : "false", b->gt911->deferred);
     }
     if (b->i2c0) {
         g_string_append_printf(j, "\"i2c0\":{\"transactions\":%" PRIu64 ",\"nacks\":%" PRIu64 ",\"last_addr\":\"0x%02x\"},",
diff --git a/include/hw/misc/x4pro_i2c_devs.h b/include/hw/misc/x4pro_i2c_devs.h
index c77ca4f..7072fa2 100644
--- a/include/hw/misc/x4pro_i2c_devs.h
+++ b/include/hw/misc/x4pro_i2c_devs.h
@@ -25,12 +25,23 @@ struct X4ProGt911State {
     uint16_t ptr;
     int byte_index;
     uint8_t config[GT911_CONFIG_LEN];
+    /* the live input, as the tooling set it last */
     Gt911Point pts[GT911_MAX_POINTS];
     int count;
     bool home;
+    /* the frame in the output registers: latched when produced, so a read sees one coherent
+     * controller frame whatever the tooling does meanwhile */
+    Gt911Point frame_pts[GT911_MAX_POINTS];
+    int frame_count;
+    bool frame_home;
     bool frame_ready;
+    bool pending;                   /* the input changed while a frame was waiting: report it next */
     uint64_t frames, reads, clears, start_nacks;
     uint64_t key_reads;             /* key-value byte read while the Home pad is down */
+    uint64_t input_seq;             /* bumped by every x4pro_gt911_set_touch */
+    uint64_t frame_seq;             /* input_seq the current frame was taken from */
+    uint64_t read_seq;              /* input_seq of the last frame the firmware cleared */
+    uint64_t deferred;              /* input changes that arrived while a frame was pending */
     bool require_power;
     int (*powered)(void *opaque);   /* board callback: is the touch rail on? */
     void *powered_opaque;
