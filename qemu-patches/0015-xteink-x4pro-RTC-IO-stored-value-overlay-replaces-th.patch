+    }
     if (b->rf) {
         g_string_append_printf(j, "\"rf\":{\"reads\":%" PRIu64 ",\"writes\":%" PRIu64 ",\"sticky\":%d,\"hot\":",
                                b->rf->reads, b->rf->writes, b->rf->n_sticky);
@@ -752,6 +757,17 @@ static void x4pro_machine_init(MachineState *machine)
         saradc = ESP32S3_SARADC(dev);
     }
 
+    /* RTC IO pads at 0x60008400: hold / pull / sleep-isolation configuration, read back as written */
+    X4ProRtcIoState *rtcio;
+    {
+        DeviceState *dev = qdev_new(TYPE_X4PRO_RTCIO);
+        object_property_add_child(OBJECT(machine), "x4pro-rtcio", OBJECT(dev));
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_RTCIO_BASE, mr, 2);
+        rtcio = X4PRO_RTCIO(dev);
+    }
+
     /* Radio register stub: FE2 / FE / RX / BB blocks the PHY programs and polls */
     ESP32S3RfStubState *rf;
     {
@@ -772,7 +788,7 @@ static void x4pro_machine_init(MachineState *machine)
         X4ProBoardState *b = X4PRO_BOARD(dev);
         b->gpio = gpio; b->spi2 = spi2; b->epd = epd; b->usj = usj_state; b->input = input;
         b->i2c0 = i2c0; b->gt911 = gt911; b->cw2017 = cw2017; b->rtc = rtc;
-        b->ledc = ledc; b->sleep = sleep; b->ana = ana; b->saradc = saradc; b->rf = rf;
+        b->ledc = ledc; b->sleep = sleep; b->ana = ana; b->saradc = saradc; b->rf = rf; b->rtcio = rtcio;
         qdev_realize_and_unref(dev, NULL, &error_fatal);
     }
 
diff --git a/include/hw/misc/x4pro_rtcio.h b/include/hw/misc/x4pro_rtcio.h
new file mode 100644
index 0000000..335788b
--- /dev/null
+++ b/include/hw/misc/x4pro_rtcio.h
@@ -0,0 +1,26 @@
+/*
+ * ESP32-S3 RTC IO block (DR_REG_RTCIO_BASE 0x60008400, 1 KB): the RTC-domain pad
+ * configuration (hold, pull, sleep isolation, drive) firmware programs around
+ * deep sleep. Stored-value overlay: registers read back as written, the W1TS/W1TC
+ * pairs act on OUT/ENABLE/STATUS. No electrical behaviour.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_X4PRO_RTCIO "x4pro.rtcio"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProRtcIoState, X4PRO_RTCIO)
+
+#define X4PRO_RTCIO_SIZE 0x400
+#define X4PRO_RTCIO_PADS 22          /* RTC IO n = GPIO n: TOUCH_PAD0..14, XTAL_32P/N, PAD_DAC1/2, PAD19..21 */
+
+struct X4ProRtcIoState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t reg[X4PRO_RTCIO_SIZE / 4];
+    uint64_t reads, writes, pad_writes;   /* pad_writes: the per-pad registers +0x84..+0xD8 */
+};
+
+/* mask of RTC IOs whose pad register has HOLD (bit 31) set */
+uint32_t x4pro_rtcio_hold_mask(X4ProRtcIoState *s);
