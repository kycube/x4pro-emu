 };
 
 static void x4pro_board_get_state(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
@@ -482,6 +483,10 @@ static void x4pro_board_get_state(Object *obj, Visitor *v, const char *name, voi
             ",\"sar1_pad\":\"0x%03x\",\"sar2_pad\":\"0x%03x\"},",
             b->saradc->sar1_starts, b->saradc->sar2_starts, b->saradc->tsens_reads, b->saradc->sar1_pad, b->saradc->sar2_pad);
     }
+    if (b->rtcio) {
+        g_string_append_printf(j, "\"rtcio\":{\"reads\":%" PRIu64 ",\"writes\":%" PRIu64 ",\"pad_writes\":%" PRIu64 ",\"hold_mask\":\"0x%x\"},",
