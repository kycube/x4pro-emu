diff --git a/hw/misc/x4pro_rtcio.c b/hw/misc/x4pro_rtcio.c
new file mode 100644
index 0000000..82faeae
--- /dev/null
+++ b/hw/misc/x4pro_rtcio.c
@@ -0,0 +1,141 @@
+/*
+ * ESP32-S3 RTC IO block (DR_REG_RTCIO_BASE 0x60008400, 1 KB).
+ *
+ * Why: Espressif's SoC leaves the block to its silent catch-all; the stock
+ * xteink_app and CrossPoint write the pad registers around deep sleep
+ * (RTC_IO_TOUCH_PAD3 for the power button's EXT1 wake, XTAL_32N, TOUCH_PAD0..:
+ * hold, pull-up/down, sleep isolation) and read them back for read-modify-write,
+ * which used to land in the machine's "x4pro/rtcio" logger (docs/NEXT_PHASE.md
+ * 3.2.9). Register map (rtc_io_reg.h): +0x00 OUT, +0x04/+0x08 OUT_W1TS/W1TC,
+ * +0x0C ENABLE, +0x10/+0x14 ENABLE_W1TS/W1TC, +0x18 STATUS, +0x1C/+0x20
+ * STATUS_W1TS/W1TC, +0x24 IN, +0x28.. PIN0..21, +0x84.. TOUCH_PAD0..14 (RTC IO
+ * 0..14), +0xC0 XTAL_32P (15), +0xC4 XTAL_32N (16), +0xC8/+0xCC PAD_DAC1/2
+ * (17/18), +0xD0..+0xD8 RTC_PAD19..21, +0xDC EXT_WAKEUP0, +0xE0 XTL_EXT_CTR,
+ * +0xE4 SAR_I2C_IO, +0xE8 TOUCH_CTRL, +0x1FC DATE. Pad registers carry HOLD in
+ * bit 31, RDE/RUE (pull-down/up) bits 28/27, DRV 30:29, MUX_SEL 19, FUN_SEL 18:17,
+ * SLP_SEL 16, SLP_IE/OE 15/14 (RTC_PAD19..21 use the same layout).
+ *
+ * Model: storage; the W1TS/W1TC registers set/clear bits of their base register
+ * and read as 0; IN reads as the stored value (0: no RTC input path is modelled,
+ * the EXT1 wake goes through RTC_CNTL, hw/misc/x4pro_sleep.c). Nothing here
+ * changes a GPIO level: the GPIO model owns the pins.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/x4pro_rtcio.h"
+
+#define R_OUT             0x00
+#define R_OUT_W1TS        0x04
+#define R_OUT_W1TC        0x08
+#define R_ENABLE          0x0C
+#define R_ENABLE_W1TS     0x10
+#define R_ENABLE_W1TC     0x14
+#define R_STATUS          0x18
+#define R_STATUS_W1TS     0x1C
+#define R_STATUS_W1TC     0x20
+#define R_PAD0            0x84
+#define R_PAD_LAST        0xD8
+#define R_DATE            0x1FC
+
+#define PAD_HOLD          (1u << 31)
+
+uint32_t x4pro_rtcio_hold_mask(X4ProRtcIoState *s)
+{
+    uint32_t m = 0;
+    for (int i = 0; i < X4PRO_RTCIO_PADS; i++) {
+        if (s->reg[(R_PAD0 + 4 * i) / 4] & PAD_HOLD) {
+            m |= 1u << i;
+        }
+    }
+    return m;
+}
+
+static uint64_t x4pro_rtcio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X4ProRtcIoState *s = X4PRO_RTCIO(opaque);
+    s->reads++;
+    switch (addr) {
+    case R_OUT_W1TS:
+    case R_OUT_W1TC:
+    case R_ENABLE_W1TS:
+    case R_ENABLE_W1TC:
+    case R_STATUS_W1TS:
+    case R_STATUS_W1TC:
+        return 0;
+    default:
+        return s->reg[addr / 4];
+    }
+}
+
+static void x4pro_rtcio_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    X4ProRtcIoState *s = X4PRO_RTCIO(opaque);
+    uint32_t v = value;
+    s->writes++;
+    switch (addr) {
+    case R_OUT_W1TS:    s->reg[R_OUT / 4] |= v; return;
+    case R_OUT_W1TC:    s->reg[R_OUT / 4] &= ~v; return;
+    case R_ENABLE_W1TS: s->reg[R_ENABLE / 4] |= v; return;
+    case R_ENABLE_W1TC: s->reg[R_ENABLE / 4] &= ~v; return;
+    case R_STATUS_W1TS: s->reg[R_STATUS / 4] |= v; return;
+    case R_STATUS_W1TC: s->reg[R_STATUS / 4] &= ~v; return;
+    case R_DATE:        return;
+    case R_PAD0 ... R_PAD_LAST:
+        s->pad_writes++;
+        break;
+    default:
+        break;
+    }
+    s->reg[addr / 4] = v;
+}
+
+static const MemoryRegionOps x4pro_rtcio_ops = {
+    .read = x4pro_rtcio_read,
+    .write = x4pro_rtcio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void x4pro_rtcio_reset_hold(Object *obj, ResetType type)
+{
+    X4ProRtcIoState *s = X4PRO_RTCIO(obj);
+    /* cleared on every reset, the system reset that models a deep-sleep wake included: the real
+     * RTC domain keeps its pad latches through deep sleep, but both firmwares reprogram every pad
+     * they use before reading anything back (the counters survive for the tooling) */
+    memset(s->reg, 0, sizeof(s->reg));
+    s->reg[R_DATE / 4] = 0x2101180;   /* RTCIO_DATE as ESP-IDF's rtc_io_reg.h lists it */
+}
+
+static void x4pro_rtcio_init(Object *obj)
+{
+    X4ProRtcIoState *s = X4PRO_RTCIO(obj);
+    memory_region_init_io(&s->iomem, obj, &x4pro_rtcio_ops, s, TYPE_X4PRO_RTCIO, X4PRO_RTCIO_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static void x4pro_rtcio_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = x4pro_rtcio_reset_hold;
+}
+
+static const TypeInfo x4pro_rtcio_info = {
+    .name = TYPE_X4PRO_RTCIO,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(X4ProRtcIoState),
+    .instance_init = x4pro_rtcio_init,
+    .class_init = x4pro_rtcio_class_init,
+};
+
+static void x4pro_rtcio_register_types(void)
+{
+    type_register_static(&x4pro_rtcio_info);
+}
+
+type_init(x4pro_rtcio_register_types)
