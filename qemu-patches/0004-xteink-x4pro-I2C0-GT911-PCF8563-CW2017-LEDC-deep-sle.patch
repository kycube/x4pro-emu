diff --git a/hw/i2c/esp32s3_i2c.c b/hw/i2c/esp32s3_i2c.c
new file mode 100644
index 0000000..2ecc587
--- /dev/null
+++ b/hw/i2c/esp32s3_i2c.c
@@ -0,0 +1,348 @@
+/*
+ * ESP32-S3 I2C controller, master FIFO mode, as ESP-IDF v5.5's i2c_master
+ * driver (used by Arduino 3.x Wire through esp32-hal-i2c-ng.c) programs it.
+ *
+ * Register map from soc/i2c_reg.h (docs/audit.md). The driver fills the TX FIFO
+ * through DATA, writes the command list COMD0..7 (byte_num 0..7, ack_en 8,
+ * ack_exp 9, ack_val 10, op_code 11..13: RSTART 6 / WRITE 1 / READ 3 / STOP 2 /
+ * END 4, done 31), pulses CTR.CONF_UPGATE and sets CTR.TRANS_START. The
+ * command list is executed synchronously here against the I2CBus: the first
+ * byte after a (re)start is the address, NACKs raise NACK_INT and stop the
+ * list, STOP raises TRANS_COMPLETE, END raises END_DETECT and leaves the bus
+ * open for the next list. Bus timing registers are stored and ignored.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/i2c/esp32s3_i2c.h"
+
+#define R_SCL_LOW_PERIOD 0x00
+#define R_CTR            0x04
+#define R_SR             0x08
+#define R_TO             0x0C
+#define R_SLAVE_ADDR     0x10
+#define R_FIFO_ST        0x14
+#define R_FIFO_CONF      0x18
+#define R_DATA           0x1C
+#define R_INT_RAW        0x20
+#define R_INT_CLR        0x24
+#define R_INT_ENA        0x28
+#define R_INT_STATUS     0x2C
+#define R_COMD0          0x58
+#define R_COMD7          0x74
+#define R_DATE           0xF8
+#define R_TXFIFO_START   0x100
+#define R_RXFIFO_START   0x180
+
+#define CTR_MS_MODE      (1u << 4)
+#define CTR_TRANS_START  (1u << 5)
+#define CTR_FSM_RST      (1u << 10)
+#define CTR_CONF_UPGATE  (1u << 11)
+
+#define FIFO_CONF_NONFIFO_EN (1u << 10)
+#define FIFO_CONF_RX_RST     (1u << 12)
+#define FIFO_CONF_TX_RST     (1u << 13)
+
+#define INT_RXFIFO_WM     (1u << 0)
+#define INT_TXFIFO_WM     (1u << 1)
+#define INT_RXFIFO_OVF    (1u << 2)
+#define INT_END_DETECT    (1u << 3)
+#define INT_BYTE_TRANS    (1u << 4)
+#define INT_ARB_LOST      (1u << 5)
+#define INT_MST_TXFIFO_UDF (1u << 6)
+#define INT_TRANS_COMPLETE (1u << 7)
+#define INT_TIME_OUT      (1u << 8)
+#define INT_TRANS_START   (1u << 9)
+#define INT_NACK          (1u << 10)
+#define INT_ALL           0x3FFFFu
+
+#define OP_RSTART 6
+#define OP_WRITE  1
+#define OP_READ   3
+#define OP_STOP   2
+#define OP_END    4
+
+static void i2c_update_irq(ESP32S3I2CState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+static void i2c_trace(ESP32S3I2CState *s, uint8_t addr, bool read, const uint8_t *w, int nw,
+                      const uint8_t *r, int nr, bool nack)
+{
+    if (!s->trace) {
+        return;
+    }
+    fprintf(s->trace, "{\"t_us\":%" PRId64 ",\"addr\":\"0x%02x\",\"rw\":\"%s\",\"w\":\"",
+            qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1000, addr, read ? "r" : "w");
+    for (int i = 0; i < nw; i++) fprintf(s->trace, "%s%02x", i ? " " : "", w[i]);
+    fprintf(s->trace, "\",\"r\":\"");
+    for (int i = 0; i < nr; i++) fprintf(s->trace, "%s%02x", i ? " " : "", r[i]);
+    fprintf(s->trace, "\"%s}\n", nack ? ",\"nack\":true" : "");
+    fflush(s->trace);
+}
+
+static void i2c_run_commands(ESP32S3I2CState *s)
+{
+    uint32_t tx_pos = 0;
+    bool addr_pending = false;
+    bool nacked = false;
+    uint8_t tw[64], tr[64];
+    int nw = 0, nr = 0;
+    uint8_t taddr = s->last_addr;
+    bool tread = false;
+
+    s->int_raw |= INT_TRANS_START;
+    for (int i = 0; i < ESP32S3_I2C_CMD_COUNT && !nacked; i++) {
+        uint32_t c = s->comd[i];
+        int op = (c >> 11) & 7;
+        int n = c & 0xFF;
+        bool ack_val = (c >> 10) & 1;
+        bool ack_en = (c >> 8) & 1;
+        bool done_cmd = true;
+
+        switch (op) {
+        case OP_RSTART:
+            addr_pending = true;
+            if (s->bus_open && nw + nr) {
+                i2c_trace(s, taddr, tread, tw, nw, tr, nr, false);
+                nw = nr = 0;
+            }
+            s->bus_open = true;
+            break;
+        case OP_WRITE:
+            for (int k = 0; k < n; k++) {
+                if (tx_pos >= s->tx_len) {
+                    s->int_raw |= INT_MST_TXFIFO_UDF;
+                    break;
+                }
+                uint8_t b = s->txfifo[tx_pos++];
+                int ret;
+                if (addr_pending) {
+                    addr_pending = false;
+                    taddr = b >> 1;
+                    tread = b & 1;
+                    s->last_addr = taddr;
+                    ret = i2c_start_transfer(s->bus, taddr, tread);
+                    s->transactions++;
+                } else {
+                    ret = i2c_send(s->bus, b);
+                    if (nw < 64) tw[nw++] = b;
+                }
+                if (ret && ack_en) {
+                    nacked = true;
+                    s->nacks++;
+                    s->int_raw |= INT_NACK;
+                    i2c_end_transfer(s->bus);
+                    s->bus_open = false;
+                    break;
+                }
+            }
+            break;
+        case OP_READ:
+            for (int k = 0; k < n; k++) {
+                uint8_t b = i2c_recv(s->bus);
+                if (s->rx_len < ESP32S3_I2C_FIFO_LEN) {
+                    s->rxfifo[s->rx_len++] = b;
+                } else {
+                    s->int_raw |= INT_RXFIFO_OVF;
+                }
+                if (nr < 64) tr[nr++] = b;
+                if (k == n - 1 && ack_val) {
+                    i2c_nack(s->bus);
+                }
+            }
+            break;
+        case OP_STOP:
+            if (s->bus_open) {
+                i2c_end_transfer(s->bus);
+            }
+            s->bus_open = false;
+            s->int_raw |= INT_TRANS_COMPLETE;
+            s->comd[i] |= 1u << 31;
+            i = ESP32S3_I2C_CMD_COUNT;   /* finished */
+            break;
+        case OP_END:
+            s->int_raw |= INT_END_DETECT;
+            s->comd[i] |= 1u << 31;
+            i = ESP32S3_I2C_CMD_COUNT;
+            break;
+        default:
+            done_cmd = false;
+            i = ESP32S3_I2C_CMD_COUNT;
+            break;
+        }
+        if (done_cmd && i < ESP32S3_I2C_CMD_COUNT) {
+            s->comd[i] |= 1u << 31;
+        }
+    }
+    /* consumed TX bytes leave the FIFO */
+    if (tx_pos < s->tx_len) {
+        memmove(s->txfifo, s->txfifo + tx_pos, s->tx_len - tx_pos);
+    }
+    s->tx_len -= tx_pos;
+    i2c_trace(s, taddr, tread, tw, nw, tr, nr, nacked);
+    s->ctr &= ~CTR_TRANS_START;
+    i2c_update_irq(s);
+}
+
+static uint64_t i2c_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(opaque);
+    uint32_t r = 0;
+    switch (addr) {
+    case R_CTR:
+        r = s->ctr & ~(CTR_TRANS_START | CTR_FSM_RST | CTR_CONF_UPGATE);
+        break;
+    case R_SR:
+        r = ((s->rx_len - s->rx_pos) & 0x3F) << 8 | (s->tx_len & 0x3F) << 18 | (s->bus_open ? (1u << 4) : 0);
+        break;
+    case R_FIFO_ST:
+        r = (s->rx_pos & 0x1F) | (s->rx_len & 0x1F) << 5 | 0 << 10 | (s->tx_len & 0x1F) << 15;
+        break;
+    case R_FIFO_CONF:
+        r = s->fifo_conf & ~(FIFO_CONF_RX_RST | FIFO_CONF_TX_RST);
+        break;
+    case R_DATA:
+        if (s->rx_pos < s->rx_len) {
+            r = s->rxfifo[s->rx_pos++];
+            if (s->rx_pos >= s->rx_len) {
+                s->rx_pos = s->rx_len = 0;
+            }
+        }
+        break;
+    case R_INT_RAW:    r = s->int_raw; break;
+    case R_INT_ENA:    r = s->int_ena; break;
+    case R_INT_STATUS: r = s->int_raw & s->int_ena; break;
+    case R_DATE:       r = 0x20070201; break;
+    default:
+        if (addr >= R_COMD0 && addr <= R_COMD7) {
+            r = s->comd[(addr - R_COMD0) / 4];
+        } else if (addr < 0x100) {
+            r = s->timing[addr / 4];
+        } else if (addr >= R_RXFIFO_START && addr < R_RXFIFO_START + 0x80) {
+            r = s->rxfifo[((addr - R_RXFIFO_START) / 4) % ESP32S3_I2C_FIFO_LEN];
+        } else {
+            qemu_log_mask(LOG_UNIMP, "esp32s3.i2c: unhandled read +0x%" HWADDR_PRIx "\n", addr);
+        }
+    }
+    return r;
+}
+
+static void i2c_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(opaque);
+    uint32_t v = value;
+    switch (addr) {
+    case R_CTR:
+        s->ctr = v & ~(CTR_FSM_RST | CTR_CONF_UPGATE);
+        if (v & CTR_FSM_RST) {
+            s->bus_open = false;
+        }
+        if (v & CTR_TRANS_START) {
+            i2c_run_commands(s);
+        }
+        break;
+    case R_FIFO_CONF:
+        s->fifo_conf = v;
+        if (v & FIFO_CONF_TX_RST) s->tx_len = 0;
+        if (v & FIFO_CONF_RX_RST) s->rx_len = s->rx_pos = 0;
+        break;
+    case R_DATA:
+        if (s->tx_len < ESP32S3_I2C_FIFO_LEN) {
+            s->txfifo[s->tx_len++] = v & 0xFF;
+        }
+        break;
+    case R_INT_ENA: s->int_ena = v & INT_ALL; i2c_update_irq(s); break;
+    case R_INT_CLR: s->int_raw &= ~(v & INT_ALL); i2c_update_irq(s); break;
+    case R_INT_RAW: break;
+    default:
+        if (addr >= R_COMD0 && addr <= R_COMD7) {
+            s->comd[(addr - R_COMD0) / 4] = v & 0x7FFFFFFF;   /* done is read-only */
+        } else if (addr < 0x100) {
+            s->timing[addr / 4] = v;
+        } else if (addr >= R_TXFIFO_START && addr < R_TXFIFO_START + 0x80) {
+            if (s->tx_len < ESP32S3_I2C_FIFO_LEN) s->txfifo[s->tx_len++] = v & 0xFF;
+        } else {
+            qemu_log_mask(LOG_UNIMP, "esp32s3.i2c: unhandled write +0x%" HWADDR_PRIx " = 0x%x\n", addr, v);
+        }
+    }
+}
+
+static const MemoryRegionOps i2c_ops = {
+    .read = i2c_read,
+    .write = i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void i2c_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+    s->ctr = 0;
+    s->fifo_conf = 0;
+    s->int_raw = 0;
+    s->int_ena = 0;
+    memset(s->comd, 0, sizeof(s->comd));
+    s->tx_len = s->rx_len = s->rx_pos = 0;
+    s->bus_open = false;
+}
+
+static void i2c_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(dev);
+    if (s->trace_path && s->trace_path[0]) {
+        s->trace = fopen(s->trace_path, "w");
+        if (!s->trace) {
+            error_setg(errp, "esp32s3.i2c: cannot open %s", s->trace_path);
+        }
+    }
+}
+
+static void i2c_init(Object *obj)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &i2c_ops, s, TYPE_ESP32S3_I2C, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->bus = i2c_init_bus(DEVICE(s), "i2c");
+}
+
+static Property i2c_properties[] = {
+    DEFINE_PROP_STRING("trace-i2c", ESP32S3I2CState, trace_path),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void i2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = i2c_reset_hold;
+    dc->realize = i2c_realize;
+    device_class_set_props(dc, i2c_properties);
+}
+
+static const TypeInfo i2c_info = {
+    .name = TYPE_ESP32S3_I2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3I2CState),
+    .instance_init = i2c_init,
+    .class_init = i2c_class_init,
+};
+
+static void i2c_register_types(void)
+{
+    type_register_static(&i2c_info);
+}
+
+type_init(i2c_register_types)
