diff --git a/hw/misc/esp32s3_ledc.c b/hw/misc/esp32s3_ledc.c
new file mode 100644
index 0000000..6b5dc77
--- /dev/null
+++ b/hw/misc/esp32s3_ledc.c
@@ -0,0 +1,187 @@
+/*
+ * ESP32-S3 LEDC. Register map from soc/ledc_reg.h (docs/audit.md):
+ *   LSCHn_CONF0 +0x14n (TIMER_SEL bits 0..1, SIG_OUT_EN bit 2, IDLE_LV bit 3, PARA_UP bit 4),
+ *   LSCHn_HPOINT +0x14n+4, LSCHn_DUTY +0x14n+8 (duty << 4), LSCHn_CONF1 +0x14n+0xC
+ *   (DUTY_START bit 31), LSCHn_DUTY_R +0x14n+0x10, LSTIMERn_CONF +0xA0+8n (DUTY_RES
+ *   bits 0..3, CLK_DIV bits 4..21, PAUSE 22, RST 23, TICK_SEL 24, PARA_UP 25),
+ *   LSTIMERn_VALUE +0xA4+8n, INT_RAW/ST/ENA/CLR +0xC0..+0xCC (OVF timer n = bit n,
+ *   DUTY_CHNG_END ch n = bit 4+n), CONF +0xD0 (APB_CLK_SEL bits 0..1).
+ * A duty change completes instantly (DUTY_CHNG_END raised on DUTY_START).
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32s3_ledc.h"
+
+#define R_CH_BASE     0x00
+#define R_CH_STRIDE   0x14
+#define R_TIMER_BASE  0xA0
+#define R_INT_RAW     0xC0
+#define R_INT_ST      0xC4
+#define R_INT_ENA     0xC8
+#define R_INT_CLR     0xCC
+#define R_CONF        0xD0
+#define R_DATE        0xFC
+
+#define CONF0_SIG_OUT_EN (1u << 2)
+#define CONF1_DUTY_START (1u << 31)
+
+static void ledc_update_irq(ESP32S3LedcState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+int esp32s3_ledc_duty_permille(ESP32S3LedcState *s, int ch)
+{
+    if (ch < 0 || ch >= ESP32S3_LEDC_CHANNELS || !(s->ch_conf0[ch] & CONF0_SIG_OUT_EN)) {
+        return -1;
+    }
+    int timer = s->ch_conf0[ch] & 3;
+    int res = s->timer_conf[timer] & 0xF;
+    if (!res) {
+        return 0;
+    }
+    uint32_t max = 1u << res;
+    uint32_t duty = (s->ch_duty[ch] >> 4) & 0xFFFFF;
+    if (duty >= max) duty = max;
+    return (int)((uint64_t)duty * 1000 / max);
+}
+
+uint32_t esp32s3_ledc_freq_hz(ESP32S3LedcState *s, int ch)
+{
+    /* clk_div is Q18.8; source clock per CONF.APB_CLK_SEL: 1 = APB 80 MHz, 2 = RC_FAST ~17.5 MHz, 3 = XTAL 40 MHz */
+    int timer = s->ch_conf0[ch] & 3;
+    uint32_t res = s->timer_conf[timer] & 0xF;
+    uint32_t div = (s->timer_conf[timer] >> 4) & 0x3FFFF;
+    uint32_t src = 80000000;
+    switch (s->conf & 3) { case 2: src = 17500000; break; case 3: src = 40000000; break; default: break; }
+    if (!div || !res) return 0;
+    return (uint32_t)(((uint64_t)src * 256) / div / (1u << res));
+}
+
+static uint64_t ledc_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3LedcState *s = ESP32S3_LEDC(opaque);
+    uint32_t r = 0;
+    if (addr < R_TIMER_BASE) {
+        int ch = addr / R_CH_STRIDE, off = addr % R_CH_STRIDE;
+        switch (off) {
+        case 0x0: r = s->ch_conf0[ch] & ~(1u << 4); break;
+        case 0x4: r = s->ch_hpoint[ch]; break;
+        case 0x8: r = s->ch_duty[ch]; break;
+        case 0xC: r = s->ch_conf1[ch] & ~CONF1_DUTY_START; break;
+        case 0x10: r = s->ch_duty[ch]; break;   /* DUTY_R: current duty */
+        }
+        return r;
+    }
+    if (addr >= R_TIMER_BASE && addr < R_INT_RAW) {
+        int t = (addr - R_TIMER_BASE) / 8;
+        if (((addr - R_TIMER_BASE) % 8) == 0) {
+            return s->timer_conf[t] & ~(1u << 25);
+        }
+        return 0;   /* timer value: not modelled */
+    }
+    switch (addr) {
+    case R_INT_RAW: return s->int_raw;
+    case R_INT_ST:  return s->int_raw & s->int_ena;
+    case R_INT_ENA: return s->int_ena;
+    case R_CONF:    return s->conf;
+    case R_DATE:    return 0x19040100;
+    default:
+        qemu_log_mask(LOG_UNIMP, "esp32s3.ledc: unhandled read +0x%" HWADDR_PRIx "\n", addr);
+        return 0;
+    }
+}
+
+static void ledc_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3LedcState *s = ESP32S3_LEDC(opaque);
+    uint32_t v = value;
+    if (addr < R_TIMER_BASE) {
+        int ch = addr / R_CH_STRIDE, off = addr % R_CH_STRIDE;
+        switch (off) {
+        case 0x0: s->ch_conf0[ch] = v; break;
+        case 0x4: s->ch_hpoint[ch] = v; break;
+        case 0x8: s->ch_duty[ch] = v; break;
+        case 0xC:
+            s->ch_conf1[ch] = v;
+            if (v & CONF1_DUTY_START) {
+                s->duty_updates++;
+                s->int_raw |= 1u << (4 + ch);   /* DUTY_CHNG_END: the (instant) fade finished */
+                ledc_update_irq(s);
+            }
+            break;
+        default: break;
+        }
+        return;
+    }
+    if (addr >= R_TIMER_BASE && addr < R_INT_RAW) {
+        int t = (addr - R_TIMER_BASE) / 8;
+        if (((addr - R_TIMER_BASE) % 8) == 0) {
+            s->timer_conf[t] = v;
+        }
+        return;
+    }
+    switch (addr) {
+    case R_INT_ENA: s->int_ena = v; ledc_update_irq(s); break;
+    case R_INT_CLR: s->int_raw &= ~v; ledc_update_irq(s); break;
+    case R_INT_RAW: break;
+    case R_CONF:    s->conf = v; break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "esp32s3.ledc: unhandled write +0x%" HWADDR_PRIx " = 0x%x\n", addr, v);
+    }
+}
+
+static const MemoryRegionOps ledc_ops = {
+    .read = ledc_read,
+    .write = ledc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void ledc_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3LedcState *s = ESP32S3_LEDC(obj);
+    memset(s->ch_conf0, 0, sizeof(s->ch_conf0));
+    memset(s->ch_hpoint, 0, sizeof(s->ch_hpoint));
+    memset(s->ch_duty, 0, sizeof(s->ch_duty));
+    memset(s->ch_conf1, 0, sizeof(s->ch_conf1));
+    memset(s->timer_conf, 0, sizeof(s->timer_conf));
+    s->int_raw = s->int_ena = 0;
+    s->conf = 0;
+}
+
+static void ledc_init(Object *obj)
+{
+    ESP32S3LedcState *s = ESP32S3_LEDC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &ledc_ops, s, TYPE_ESP32S3_LEDC, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static void ledc_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = ledc_reset_hold;
+}
+
+static const TypeInfo ledc_info = {
+    .name = TYPE_ESP32S3_LEDC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3LedcState),
+    .instance_init = ledc_init,
+    .class_init = ledc_class_init,
+};
+
+static void ledc_register_types(void)
+{
+    type_register_static(&ledc_info);
+}
+
+type_init(ledc_register_types)
