+
+static void x4pro_input_set_touch(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    X4ProInputState *s = X4PRO_INPUT(obj);
+    char *val = NULL;
+    if (!visit_type_str(v, name, &val, errp)) {
+        return;
+    }
+    QObject *qo = qobject_from_json(val, errp);
+    if (!qo) {
+        g_free(val);
+        return;
+    }
+    QList *list = qobject_to(QList, qo);
+    if (!list) {
+        error_setg(errp, "touch: expected a JSON array");
+        qobject_unref(qo); g_free(val);
+        return;
+    }
+    int n = 0;
+    const QListEntry *e;
+    for (e = qlist_first(list); e && n < GT911_MAX_POINTS; e = qlist_next(e)) {
+        QDict *d = qobject_to(QDict, qlist_entry_obj(e));
+        if (!d) continue;
+        s->touch_pts[n].x = qdict_get_try_int(d, "x", 0);
+        s->touch_pts[n].y = qdict_get_try_int(d, "y", 0);
+        s->touch_pts[n].size = qdict_get_try_int(d, "size", 20);
+        s->touch_pts[n].id = qdict_get_try_int(d, "id", n);
+        n++;
+    }
+    s->touch_count = n;
+    g_free(s->touch_json);
+    s->touch_json = val;
+    qobject_unref(qo);
+    if (s->gt911) {
+        x4pro_gt911_set_touch(s->gt911, s->touch_pts, s->touch_count, s->home);
+    }
+}
