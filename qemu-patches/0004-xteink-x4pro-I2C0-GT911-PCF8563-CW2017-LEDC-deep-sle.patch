diff --git a/hw/misc/x4pro_i2c_devs.c b/hw/misc/x4pro_i2c_devs.c
new file mode 100644
index 0000000..7d1b9f1
--- /dev/null
+++ b/hw/misc/x4pro_i2c_devs.c
@@ -0,0 +1,396 @@
+/*
+ * X4 Pro I2C peripherals.
+ *
+ * GT911 (freeink InputManager::beginGt911/pollGt911): 16-bit register pointer
+ * written MSB first, auto-increment; 0x814E status (bit 7 buffer ready, bit 4
+ * Home pad, bits 0..3 point count), 0x8150.. 8-byte point records (X lo/hi,
+ * Y lo/hi, size lo/hi, reserved, id), product ID "911" at 0x8140, config area
+ * 0x8047.. accepted. INT is driven LOW while a frame is pending and released
+ * when the firmware writes 0 to 0x814E; a held finger produces a new frame
+ * 10 ms after each clear, a release produces one count-0 frame. The chip only
+ * answers while its rail is on (GPIO2 LOW) unless require-power is off.
+ *
+ * PCF8563: 16 BCD registers; time = seed (host wall clock at start) + guest
+ * virtual time; writes to the time registers move the seed.
+ *
+ * CW2017 (freeink BatteryMonitor): VERSION 0x00 = 0x0D (running), VCELL
+ * 0x02/0x03 (14-bit, mV = (raw*5+8)>>4), SOC 0x04, MODE 0x08, SOC_ALERT 0x0B
+ * (bit 7 = profile loaded), BATINFO 0x10..0x5F pre-loaded with the OEM table
+ * so the firmware finds the profile resident.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/x4pro_i2c_devs.h"
+
+/* ===================== GT911 ============================================= */
+
+static const uint8_t gt911_id[11] = { '9', '1', '1', 0, 0x60, 0x10, 0xE0, 0x01, 0x20, 0x03, 0x00 };
+/* 0x8140..0x8143 product id, 0x8144..45 firmware version 0x1060, 0x8146..47 x res 480,
+ * 0x8148..49 y res 800, 0x814A vendor id */
+
+static void gt911_update_int(X4ProGt911State *s)
+{
+    qemu_set_irq(s->irq_out, s->frame_ready ? 0 : 1);
+}
+
+static void gt911_frame_timer(void *opaque)
+{
+    X4ProGt911State *s = X4PRO_GT911(opaque);
+    if (s->count > 0 || s->home) {
+        s->frame_ready = true;
+        s->frames++;
+        gt911_update_int(s);
+    }
+}
+
+void x4pro_gt911_set_touch(X4ProGt911State *s, const Gt911Point *pts, int count, bool home)
+{
+    if (count > GT911_MAX_POINTS) count = GT911_MAX_POINTS;
+    memcpy(s->pts, pts, count * sizeof(*pts));
+    s->count = count;
+    s->home = home;
+    s->frame_ready = true;      /* every change is a new frame, including the release */
+    s->frames++;
+    gt911_update_int(s);
+}
+
+static int gt911_event(I2CSlave *i2c, enum i2c_event event)
+{
+    X4ProGt911State *s = X4PRO_GT911(i2c);
+    switch (event) {
+    case I2C_START_SEND:
+        s->byte_index = 0;
+        /* fallthrough */
+    case I2C_START_RECV:
+        if (s->require_power && s->powered && !s->powered(s->powered_opaque)) {
+            s->start_nacks++;
+            if (s->start_nacks == 1) {
+                qemu_log_mask(LOG_GUEST_ERROR, "x4pro.gt911: addressed while GPIO2 is not LOW (rail off)\n");
+            }
+            return 1;   /* NACK: unpowered chip */
+        }
+        break;
+    default:
+        break;
+    }
+    return 0;
+}
+
+static int gt911_send(I2CSlave *i2c, uint8_t data)
+{
+    X4ProGt911State *s = X4PRO_GT911(i2c);
+    if (s->byte_index == 0) {
+        s->ptr = data << 8;
+    } else if (s->byte_index == 1) {
+        s->ptr |= data;
+    } else {
+        uint16_t r = s->ptr++;
+        if (r == 0x814E) {
+            s->clears++;
+            s->frame_ready = false;
+            gt911_update_int(s);
+            if (s->count > 0 || s->home) {
+                timer_mod(s->frame_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 10 * 1000000);
+            }
+        } else if (r >= GT911_CONFIG_BASE && r < GT911_CONFIG_BASE + GT911_CONFIG_LEN) {
+            s->config[r - GT911_CONFIG_BASE] = data;
+        }
+    }
+    s->byte_index++;
+    return 0;
+}
+
+static uint8_t gt911_recv(I2CSlave *i2c)
+{
+    X4ProGt911State *s = X4PRO_GT911(i2c);
+    uint16_t r = s->ptr++;
+    s->reads++;
+    if (r == 0x814E) {
+        return (s->frame_ready ? 0x80 : 0) | (s->home ? 0x10 : 0) | (s->count & 0x0F);
+    }
+    if (r >= 0x8150 && r < 0x8150 + 8 * GT911_MAX_POINTS) {
+        int i = (r - 0x8150) / 8, k = (r - 0x8150) % 8;
+        if (i >= s->count) return 0;
+        const Gt911Point *p = &s->pts[i];
+        switch (k) {
+        case 0: return p->x & 0xFF;
+        case 1: return p->x >> 8;
+        case 2: return p->y & 0xFF;
+        case 3: return p->y >> 8;
+        case 4: return p->size & 0xFF;
+        case 5: return p->size >> 8;
+        case 6: return 0;
+        case 7: return p->id;
+        }
+    }
+    if (r >= 0x8140 && r < 0x8140 + sizeof(gt911_id)) {
+        return gt911_id[r - 0x8140];
+    }
+    if (r >= GT911_CONFIG_BASE && r < GT911_CONFIG_BASE + GT911_CONFIG_LEN) {
+        return s->config[r - GT911_CONFIG_BASE];
+    }
+    return 0;
+}
+
+static void gt911_reset_hold(Object *obj, ResetType type)
+{
+    X4ProGt911State *s = X4PRO_GT911(obj);
+    s->ptr = 0;
+    s->byte_index = 0;
+    /* touch state set by the tooling survives a guest reset */
+    gt911_update_int(s);
+}
+
+static void gt911_realize(DeviceState *dev, Error **errp)
+{
+    X4ProGt911State *s = X4PRO_GT911(dev);
+    s->frame_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, gt911_frame_timer, s);
+    /* a plausible self-loaded config: version 'A', 480x800, 5 touches */
+    memset(s->config, 0, sizeof(s->config));
+    s->config[0] = 0x41;
+    s->config[1] = 480 & 0xFF; s->config[2] = 480 >> 8;
+    s->config[3] = 800 & 0xFF; s->config[4] = 800 >> 8;
+    s->config[5] = 5;
+}
+
+static void gt911_init(Object *obj)
+{
+    X4ProGt911State *s = X4PRO_GT911(obj);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->irq_out, "int", 1);
+}
+
+static Property gt911_properties[] = {
+    DEFINE_PROP_BOOL("require-power", X4ProGt911State, require_power, true),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void gt911_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    k->event = gt911_event;
+    k->send = gt911_send;
+    k->recv = gt911_recv;
+    dc->realize = gt911_realize;
+    rc->phases.hold = gt911_reset_hold;
+    device_class_set_props(dc, gt911_properties);
+}
+
+static const TypeInfo gt911_info = {
+    .name = TYPE_X4PRO_GT911,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(X4ProGt911State),
+    .instance_init = gt911_init,
+    .class_init = gt911_class_init,
+};
+
+/* ===================== PCF8563 / BM8563 =================================== */
+
+static uint8_t to_bcd(int v) { return (uint8_t)(((v / 10) << 4) | (v % 10)); }
+static int from_bcd(uint8_t v) { return ((v >> 4) & 0xF) * 10 + (v & 0xF); }
+
+static void pcf_refresh_time(X4ProPcf8563State *s)
+{
+    int64_t now_vt = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    time_t t = s->base_epoch + (now_vt - s->base_vt_ns) / 1000000000LL;
+    struct tm tm;
+    gmtime_r(&t, &tm);
+    s->regs[2] = to_bcd(tm.tm_sec);              /* VL bit 7 = 0: clock valid */
+    s->regs[3] = to_bcd(tm.tm_min);
+    s->regs[4] = to_bcd(tm.tm_hour);
+    s->regs[5] = to_bcd(tm.tm_mday);
+    s->regs[6] = (uint8_t)tm.tm_wday;
+    s->regs[7] = to_bcd(tm.tm_mon + 1);          /* century bit 7 = 0 (20xx) */
+    s->regs[8] = to_bcd(tm.tm_year % 100);
+}
+
+static void pcf_apply_time(X4ProPcf8563State *s)
+{
+    struct tm tm = {0};
+    tm.tm_sec = from_bcd(s->regs[2] & 0x7F);
+    tm.tm_min = from_bcd(s->regs[3] & 0x7F);
+    tm.tm_hour = from_bcd(s->regs[4] & 0x3F);
+    tm.tm_mday = from_bcd(s->regs[5] & 0x3F);
+    tm.tm_mon = from_bcd(s->regs[7] & 0x1F) - 1;
+    tm.tm_year = 100 + from_bcd(s->regs[8]);
+    s->base_epoch = timegm(&tm);
+    s->base_vt_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static int pcf_event(I2CSlave *i2c, enum i2c_event event)
+{
+    X4ProPcf8563State *s = X4PRO_PCF8563(i2c);
+    if (event == I2C_START_SEND) {
+        s->byte_index = 0;
+    } else if (event == I2C_START_RECV) {
+        pcf_refresh_time(s);
+    }
+    return 0;
+}
+
+static int pcf_send(I2CSlave *i2c, uint8_t data)
+{
+    X4ProPcf8563State *s = X4PRO_PCF8563(i2c);
+    if (s->byte_index == 0) {
+        s->ptr = data & 0x0F;
+    } else {
+        uint8_t r = s->ptr;
+        s->regs[r] = data;
+        s->ptr = (r + 1) & 0x0F;
+        s->writes++;
+        if (r == 8) {          /* the year is the last time register written */
+            pcf_apply_time(s);
+        }
+    }
+    s->byte_index++;
+    return 0;
+}
+
+static uint8_t pcf_recv(I2CSlave *i2c)
+{
+    X4ProPcf8563State *s = X4PRO_PCF8563(i2c);
+    uint8_t v = s->regs[s->ptr];
+    s->ptr = (s->ptr + 1) & 0x0F;
+    s->reads++;
+    return v;
+}
+
+static void pcf_realize(DeviceState *dev, Error **errp)
+{
+    X4ProPcf8563State *s = X4PRO_PCF8563(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->base_epoch = time(NULL);
+    s->base_vt_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    pcf_refresh_time(s);
+}
+
+static void pcf_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    k->event = pcf_event;
+    k->send = pcf_send;
+    k->recv = pcf_recv;
+    dc->realize = pcf_realize;
+}
+
+static const TypeInfo pcf_info = {
+    .name = TYPE_X4PRO_PCF8563,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(X4ProPcf8563State),
+    .class_init = pcf_class_init,
+};
+
+/* ===================== CW2017 ============================================ */
+
+/* The OEM BATINFO profile (freeink BatteryMonitor.cpp, recovered from app1 @ DROM 0x3c5d8d00). */
+static const uint8_t cw2017_batinfo[80] = {
+    0x50, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xaa, 0xbf, 0xb5, 0xb4, 0xa4, 0x9c, 0xeb, 0xe2,
+    0xdf, 0xe5, 0xca, 0xa0, 0x8a, 0x62, 0x53, 0x48, 0x40, 0x3a, 0x32, 0xb1, 0xae, 0xda, 0xb5, 0xff,
+    0xff, 0xff, 0xe8, 0xdb, 0xd9, 0xd6, 0xd4, 0xd2, 0xd0, 0xcb, 0xc3, 0xbc, 0x9e, 0x87, 0x7b, 0x71,
+    0x72, 0x7c, 0x8c, 0xa3, 0xb7, 0xc8, 0xa5, 0x4f, 0x00, 0x00, 0xab, 0x02, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x64, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x23,
+};
+
+void x4pro_cw2017_set_battery(X4ProCw2017State *s, int soc, int mv)
+{
+    if (soc >= 0) s->soc = soc > 100 ? 100 : soc;
+    if (mv >= 0) s->mv = mv;
+    uint32_t raw = (s->mv * 16 + 2) / 5;   /* inverse of mV = (raw*5 + 8) >> 4 */
+    s->regs[0x02] = (raw >> 8) & 0x3F;
+    s->regs[0x03] = raw & 0xFF;
+    s->regs[0x04] = s->soc;
+    s->regs[0x05] = 0;
+}
+
+static int cw_event(I2CSlave *i2c, enum i2c_event event)
+{
+    X4ProCw2017State *s = X4PRO_CW2017(i2c);
+    if (event == I2C_START_SEND) {
+        s->byte_index = 0;
+    }
+    return 0;
+}
+
+static int cw_send(I2CSlave *i2c, uint8_t data)
+{
+    X4ProCw2017State *s = X4PRO_CW2017(i2c);
+    if (s->byte_index == 0) {
+        s->ptr = data;
+    } else {
+        uint8_t r = s->ptr++;
+        if (r < sizeof(s->regs)) {
+            if (r >= 0x10) s->batinfo_writes++;
+            if (r == 0x08) {
+                /* MODE: restart dance F0 -> 30 -> 00; stay "running" throughout */
+                s->regs[r] = data;
+            } else if (r == 0x00 || r == 0x02 || r == 0x03 || r == 0x04 || r == 0x05) {
+                /* read-only */
+            } else {
+                s->regs[r] = data;
+            }
+            s->writes++;
+        }
+    }
+    s->byte_index++;
+    return 0;
+}
+
+static uint8_t cw_recv(I2CSlave *i2c)
+{
+    X4ProCw2017State *s = X4PRO_CW2017(i2c);
+    uint8_t r = s->ptr++;
+    s->reads++;
+    return r < sizeof(s->regs) ? s->regs[r] : 0;
+}
+
+static void cw_realize(DeviceState *dev, Error **errp)
+{
+    X4ProCw2017State *s = X4PRO_CW2017(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x00] = 0x0D;          /* VERSION: running */
+    s->regs[0x08] = 0x00;          /* MODE: normal */
+    s->regs[0x0B] = 0x80;          /* SOC_ALERT: profile loaded / update enabled */
+    memcpy(&s->regs[0x10], cw2017_batinfo, sizeof(cw2017_batinfo));
+    x4pro_cw2017_set_battery(s, s->soc, s->mv);
+}
+
+static Property cw_properties[] = {
+    DEFINE_PROP_UINT32("soc", X4ProCw2017State, soc, 63),
+    DEFINE_PROP_UINT32("mv", X4ProCw2017State, mv, 3910),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void cw_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    k->event = cw_event;
+    k->send = cw_send;
+    k->recv = cw_recv;
+    dc->realize = cw_realize;
+    device_class_set_props(dc, cw_properties);
+}
+
+static const TypeInfo cw_info = {
+    .name = TYPE_X4PRO_CW2017,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(X4ProCw2017State),
+    .class_init = cw_class_init,
+};
+
+static void x4pro_i2c_devs_register_types(void)
+{
+    type_register_static(&gt911_info);
+    type_register_static(&pcf_info);
+    type_register_static(&cw_info);
+}
+
+type_init(x4pro_i2c_devs_register_types)
diff --git a/hw/misc/x4pro_sleep.c b/hw/misc/x4pro_sleep.c
new file mode 100644
index 0000000..908e5b3
--- /dev/null
+++ b/hw/misc/x4pro_sleep.c
@@ -0,0 +1,229 @@
+/*
+ * Deep sleep as a modelled reset (docs/hardware.md "Power and sleep").
+ *
+ * ESP-IDF's rtc_sleep_start(): WAKEUP_STATE.WAKEUP_ENA = triggers, INT_CLR,
+ * STATE0.SLEEP_EN = 1, then spin on INT_RAW & (SLP_REJECT | SLP_WAKEUP).
+ * Deep sleep is recognised by DIG_PWC.DG_WRAP_PD_EN (the digital domain is
+ * powered down): the VM is paused. A wake source (an RTC IO selected in
+ * EXT_WAKEUP1 reaching the EXT1 level, driven by the board's GPIO model)
+ * records EXT_WAKEUP1_STATUS and SLP_WAKEUP_CAUSE = EXT1, sets both CPUs'
+ * reset cause to DEEPSLEEP (5), requests a system reset and resumes the VM,
+ * so the ROM prints rst:0x5 (DSLEEP) and the app sees ESP_SLEEP_WAKEUP_EXT1.
+ * Light sleep (no digital power-down) returns at once with SLP_WAKEUP set.
+ *
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "sysemu/runstate.h"
+#include "sysemu/sysemu.h"
+#include "exec/memory.h"
+#include "hw/misc/x4pro_sleep.h"
+
+#define R_STATE0            0x18
+#define R_WAKEUP_STATE      0x3C
+#define R_INT_ENA           0x40
+#define R_INT_RAW           0x44
+#define R_INT_ST            0x48
+#define R_INT_CLR           0x4C
+#define R_EXT_WAKEUP_CONF   0x64
+#define R_SLP_REJECT_CONF   0x68
+#define R_DIG_PWC           0x90
+#define R_EXT_WAKEUP1       0xE0
+#define R_EXT_WAKEUP1_STATUS 0xE4
+#define R_SLP_WAKEUP_CAUSE  0x130
+#define REGION_SIZE         0x200
+
+#define STATE0_SLEEP_EN     (1u << 31)
+#define INT_SLP_WAKEUP      (1u << 0)
+#define INT_SLP_REJECT      (1u << 1)
+#define DIG_PWC_DG_WRAP_PD_EN (1u << 31)
+#define EXT_WAKEUP1_SEL_MASK 0x3FFFFFu
+#define EXT_WAKEUP1_STATUS_CLR (1u << 22)
+#define EXT_WAKEUP_CONF_EXT1_LV (1u << 31)
+#define RTC_EXT1_TRIG_EN    (1u << 1)     /* soc/rtc.h: wakeup trigger bit for EXT1 */
+
+static bool x4pro_sleep_ext1_condition(X4ProSleepState *s)
+{
+    uint32_t sel = s->ext_wakeup1 & EXT_WAKEUP1_SEL_MASK;
+    bool any_high = s->ext_wakeup_conf & EXT_WAKEUP_CONF_EXT1_LV;
+    uint32_t lv = s->gpio_levels & sel;
+    if (!sel) {
+        return false;
+    }
+    return any_high ? (lv != 0) : ((lv ^ sel) != 0);   /* any selected pin low */
+}
+
+void x4pro_sleep_wake(X4ProSleepState *s, int rtc_io)
+{
+    if (!s->sleeping) {
+        return;
+    }
+    s->sleeping = false;
+    s->wake_count++;
+    s->ext_wakeup1_status = (rtc_io >= 0) ? (1u << rtc_io) : 0;
+    s->wakeup_cause = RTC_EXT1_TRIG_EN;
+    if (s->deep) {
+        for (int i = 0; i < ESP32S3_CPU_COUNT; i++) {
+            s->rtc->reset_cause[i] = ESP32_DEEPSLEEP_RESET;
+        }
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+        if (!runstate_is_running()) {
+            vm_start();
+        }
+    } else {
+        s->int_raw |= INT_SLP_WAKEUP;
+    }
+}
+
+/* GPIO levels of pins 0..21, from the board's GPIO model */
+static void x4pro_sleep_gpio_in(void *opaque, int n, int level)
+{
+    X4ProSleepState *s = X4PRO_SLEEP(opaque);
+    if (level) {
+        s->gpio_levels |= 1u << n;
+    } else {
+        s->gpio_levels &= ~(1u << n);
+    }
+    if (s->sleeping && (s->wakeup_state >> 15 & RTC_EXT1_TRIG_EN) && x4pro_sleep_ext1_condition(s)) {
+        x4pro_sleep_wake(s, n);
+    }
+}
+
+static void x4pro_sleep_enter(X4ProSleepState *s)
+{
+    s->deep = (s->dig_pwc & DIG_PWC_DG_WRAP_PD_EN) != 0;
+    s->sleep_count++;
+    s->sleep_entered_us = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1000;
+    s->ext_wakeup1_status = 0;
+    s->wakeup_cause = 0;
+    if (!s->deep) {
+        /* light sleep: nothing to wait for in this model; wake immediately */
+        s->light_sleeps++;
+        s->int_raw |= INT_SLP_WAKEUP;
+        s->wakeup_cause = (s->wakeup_state >> 15) & 0x8;   /* pretend the timer fired if armed */
+        return;
+    }
+    s->sleeping = true;
+    /* a wake source already active (button held) wakes at once */
+    if ((s->wakeup_state >> 15 & RTC_EXT1_TRIG_EN) && x4pro_sleep_ext1_condition(s)) {
+        uint32_t sel = s->ext_wakeup1 & EXT_WAKEUP1_SEL_MASK;
+        int pin = ctz32(sel);
+        x4pro_sleep_wake(s, pin);
+        return;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "x4pro.sleep: deep sleep entered (ext1 sel=0x%x, %s); VM paused until a wake source fires\n",
+                  s->ext_wakeup1 & EXT_WAKEUP1_SEL_MASK,
+                  (s->ext_wakeup_conf & EXT_WAKEUP_CONF_EXT1_LV) ? "any-high" : "any-low");
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_PAUSED);
+}
+
+static uint64_t x4pro_sleep_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    X4ProSleepState *s = X4PRO_SLEEP(opaque);
+    uint64_t v = 0;
+    switch (addr) {
+    case R_STATE0:            return 0;
+    case R_WAKEUP_STATE:      return s->wakeup_state;
+    case R_INT_ENA:           return s->int_ena;
+    case R_INT_RAW:           return s->int_raw;
+    case R_INT_ST:            return s->int_raw & s->int_ena;
+    case R_EXT_WAKEUP_CONF:   return s->ext_wakeup_conf;
+    case R_SLP_REJECT_CONF:   return s->slp_reject_conf;
+    case R_DIG_PWC:           return s->dig_pwc;
+    case R_EXT_WAKEUP1:       return s->ext_wakeup1 & EXT_WAKEUP1_SEL_MASK;
+    case R_EXT_WAKEUP1_STATUS: return s->ext_wakeup1_status;
+    case R_SLP_WAKEUP_CAUSE:  return s->wakeup_cause;
+    default:
+        memory_region_dispatch_read(s->lower, addr, &v, size_memop(size) | MO_LE, MEMTXATTRS_UNSPECIFIED);
+        return v;
+    }
+}
+
+static void x4pro_sleep_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    X4ProSleepState *s = X4PRO_SLEEP(opaque);
+    uint32_t v = value;
+    switch (addr) {
+    case R_STATE0:
+        if (v & STATE0_SLEEP_EN) {
+            x4pro_sleep_enter(s);
+        }
+        return;
+    case R_WAKEUP_STATE:    s->wakeup_state = v; return;
+    case R_INT_ENA:         s->int_ena = v; return;
+    case R_INT_RAW:         return;
+    case R_INT_CLR:         s->int_raw &= ~v; return;
+    case R_EXT_WAKEUP_CONF: s->ext_wakeup_conf = v; return;
+    case R_SLP_REJECT_CONF: s->slp_reject_conf = v; return;
+    case R_DIG_PWC:         s->dig_pwc = v; return;
+    case R_EXT_WAKEUP1:
+        s->ext_wakeup1 = v & EXT_WAKEUP1_SEL_MASK;
+        if (v & EXT_WAKEUP1_STATUS_CLR) {
+            s->ext_wakeup1_status = 0;
+        }
+        return;
+    default:
+        memory_region_dispatch_write(s->lower, addr, value, size_memop(size) | MO_LE, MEMTXATTRS_UNSPECIFIED);
+        return;
+    }
+}
+
+static const MemoryRegionOps x4pro_sleep_ops = {
+    .read = x4pro_sleep_read,
+    .write = x4pro_sleep_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void x4pro_sleep_reset_hold(Object *obj, ResetType type)
+{
+    X4ProSleepState *s = X4PRO_SLEEP(obj);
+    /* wake status/cause survive the reset that a wake causes; sleep config does not */
+    s->wakeup_state = 0;
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->ext_wakeup_conf = 0;
+    s->slp_reject_conf = 0;
+    s->dig_pwc = 0;
+    s->ext_wakeup1 = 0;
+    s->sleeping = false;
+}
+
+static void x4pro_sleep_init(Object *obj)
+{
+    X4ProSleepState *s = X4PRO_SLEEP(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &x4pro_sleep_ops, s, TYPE_X4PRO_SLEEP, REGION_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+    qdev_init_gpio_in_named(DEVICE(obj), x4pro_sleep_gpio_in, "gpio-in", 22);
+}
+
+static void x4pro_sleep_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = x4pro_sleep_reset_hold;
+}
+
+static const TypeInfo x4pro_sleep_info = {
+    .name = TYPE_X4PRO_SLEEP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(X4ProSleepState),
+    .instance_init = x4pro_sleep_init,
+    .class_init = x4pro_sleep_class_init,
+};
+
+static void x4pro_sleep_register_types(void)
+{
+    type_register_static(&x4pro_sleep_info);
+}
+
+type_init(x4pro_sleep_register_types)
