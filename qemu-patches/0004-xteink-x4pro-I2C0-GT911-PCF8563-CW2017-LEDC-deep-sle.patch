+    ESP32S3I2CState *i2c0;
+    X4ProGt911State *gt911;
+    X4ProCw2017State *cw2017;
+    X4ProPcf8563State *rtc;
+    {
+        DeviceState *dev = qdev_new(TYPE_ESP32S3_I2C);
+        object_property_add_child(OBJECT(machine), "x4pro-i2c0", OBJECT(dev));
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_I2C_EXT_BASE, mr, 2);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, qdev_get_gpio_in(intmatrix, ETS_I2C_EXT0_INTR_SOURCE));
+        i2c0 = ESP32S3_I2C(dev);
+
+        I2CSlave *tp = i2c_slave_new(TYPE_X4PRO_GT911, 0x5D);
+        gt911 = X4PRO_GT911(tp);
+        gt911->powered = x4pro_touch_powered;
+        gt911->powered_opaque = gpio;
+        i2c_slave_realize_and_unref(tp, i2c0->bus, &error_fatal);
+        qdev_connect_gpio_out_named(DEVICE(tp), "int", 0,
+                                    qdev_get_gpio_in_named(DEVICE(gpio), ESP32S3_GPIO_PIN_IN, PIN_TP_INT));
+
+        rtc = X4PRO_PCF8563(i2c_slave_create_simple(i2c0->bus, TYPE_X4PRO_PCF8563, 0x51));
+        cw2017 = X4PRO_CW2017(i2c_slave_create_simple(i2c0->bus, TYPE_X4PRO_CW2017, 0x63));
+        input->gt911 = gt911;
+    }
+
+    /* LEDC at 0x60019000 (frontlight PWM) */
+    ESP32S3LedcState *ledc;
+    {
+        DeviceState *dev = qdev_new(TYPE_ESP32S3_LEDC);
+        object_property_add_child(OBJECT(machine), "x4pro-ledc", OBJECT(dev));
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_LEDC_BASE, mr, 2);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, qdev_get_gpio_in(intmatrix, ETS_LEDC_INTR_SOURCE));
+        ledc = ESP32S3_LEDC(dev);
+    }
+
+    /* Deep-sleep overlay on RTC_CNTL, woken by the power button (GPIO3 = RTC IO 3) */
+    X4ProSleepState *sleep;
+    {
+        Object *rtc_obj = object_resolve_path("/machine/soc/rtc_cntl", NULL);
+        DeviceState *dev = qdev_new(TYPE_X4PRO_SLEEP);
+        object_property_add_child(OBJECT(machine), "x4pro-sleep", OBJECT(dev));
+        sleep = X4PRO_SLEEP(dev);
+        sleep->rtc = ESP32S3_RTC_CNTL(rtc_obj);
+        sleep->lower = sysbus_mmio_get_region(SYS_BUS_DEVICE(rtc_obj), 0);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_RTCCNTL_BASE, mr, 2);
+        for (int p = 0; p < 22; p++) {
+            if (p == PIN_EPD_CS || p == PIN_EPD_DC || p == PIN_EPD_RST || p == PIN_EPD_SCLK || p == PIN_EPD_MOSI) {
+                continue;   /* already routed to the panel; RTC IOs used for wake are the buttons */
+            }
+            qdev_connect_gpio_out_named(DEVICE(gpio), ESP32S3_GPIO_PIN_OUT, p, qdev_get_gpio_in_named(dev, "gpio-in", p));
+        }
+    }
+
     /* Board state object: /machine/x4pro-board */
     {
         DeviceState *dev = qdev_new(TYPE_X4PRO_BOARD);
         object_property_add_child(OBJECT(machine), "x4pro-board", OBJECT(dev));
         X4ProBoardState *b = X4PRO_BOARD(dev);
         b->gpio = gpio; b->spi2 = spi2; b->epd = epd; b->usj = usj_state; b->input = input;
+        b->i2c0 = i2c0; b->gt911 = gt911; b->cw2017 = cw2017; b->rtc = rtc;
+        b->ledc = ledc; b->sleep = sleep;
         qdev_realize_and_unref(dev, NULL, &error_fatal);
     }
 
diff --git a/include/hw/i2c/esp32s3_i2c.h b/include/hw/i2c/esp32s3_i2c.h
new file mode 100644
index 0000000..3900dc3
--- /dev/null
+++ b/include/hw/i2c/esp32s3_i2c.h
@@ -0,0 +1,38 @@
+/*
+ * ESP32-S3 I2C controller (master mode, FIFO path) on a QEMU I2CBus.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/i2c/i2c.h"
+
+#define TYPE_ESP32S3_I2C "esp32s3.i2c"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3I2CState, ESP32S3_I2C)
+
+#define ESP32S3_I2C_FIFO_LEN 32
+#define ESP32S3_I2C_CMD_COUNT 8
+
+struct ESP32S3I2CState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    I2CBus *bus;
+
+    uint32_t ctr;
+    uint32_t fifo_conf;
+    uint32_t int_raw;
+    uint32_t int_ena;
+    uint32_t comd[ESP32S3_I2C_CMD_COUNT];
+    uint32_t timing[0x40];      /* SCL/SDA/TO/FILTER/CLK_CONF registers: stored, not modelled */
+    uint8_t txfifo[ESP32S3_I2C_FIFO_LEN];
+    uint8_t rxfifo[ESP32S3_I2C_FIFO_LEN];
+    uint32_t tx_len, rx_len, rx_pos;
+    bool bus_open;               /* a START was issued and no STOP yet */
+
+    char *trace_path;
+    FILE *trace;
+    uint64_t transactions;
+    uint64_t nacks;
+    uint8_t last_addr;
+};
diff --git a/include/hw/misc/esp32s3_ledc.h b/include/hw/misc/esp32s3_ledc.h
new file mode 100644
index 0000000..8d29bb4
--- /dev/null
+++ b/include/hw/misc/esp32s3_ledc.h
@@ -0,0 +1,31 @@
+/*
+ * ESP32-S3 LEDC (LED PWM) controller: low-speed channels 0..7, timers 0..3.
+ * Only duty/resolution are modelled; the result is an observable duty per channel.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_LEDC "esp32s3.ledc"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3LedcState, ESP32S3_LEDC)
+
+#define ESP32S3_LEDC_CHANNELS 8
+#define ESP32S3_LEDC_TIMERS 4
+
+struct ESP32S3LedcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t ch_conf0[ESP32S3_LEDC_CHANNELS];
+    uint32_t ch_hpoint[ESP32S3_LEDC_CHANNELS];
+    uint32_t ch_duty[ESP32S3_LEDC_CHANNELS];    /* DUTY register value (duty << 4) */
+    uint32_t ch_conf1[ESP32S3_LEDC_CHANNELS];
+    uint32_t timer_conf[ESP32S3_LEDC_TIMERS];
+    uint32_t int_raw, int_ena, conf;
+    uint64_t duty_updates;
+};
+
+/* duty in permille (0..1000) of the channel's current setting; -1 if the output is disabled */
+int esp32s3_ledc_duty_permille(ESP32S3LedcState *s, int ch);
+uint32_t esp32s3_ledc_freq_hz(ESP32S3LedcState *s, int ch);
diff --git a/include/hw/misc/x4pro_i2c_devs.h b/include/hw/misc/x4pro_i2c_devs.h
new file mode 100644
index 0000000..8d9c85e
--- /dev/null
+++ b/include/hw/misc/x4pro_i2c_devs.h
@@ -0,0 +1,68 @@
+/*
+ * X4 Pro I2C peripherals: GT911 touch (0x5D), BM8563/PCF8563 RTC (0x51),
+ * CW2017 fuel gauge (0x63).
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/i2c/i2c.h"
+#include "qemu/timer.h"
+
+/* ---- GT911 ---------------------------------------------------------------- */
+#define TYPE_X4PRO_GT911 "x4pro.gt911"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProGt911State, X4PRO_GT911)
+
+#define GT911_MAX_POINTS 5
+#define GT911_CONFIG_BASE 0x8047
+#define GT911_CONFIG_LEN  0xBA       /* 0x8047..0x8100 */
+
+typedef struct { uint16_t x, y, size; uint8_t id; } Gt911Point;
+
+struct X4ProGt911State {
+    I2CSlave parent_obj;
+    qemu_irq irq_out;             /* INT line: 0 = frame pending */
+    QEMUTimer *frame_timer;
+    uint16_t ptr;
+    int byte_index;
+    uint8_t config[GT911_CONFIG_LEN];
+    Gt911Point pts[GT911_MAX_POINTS];
+    int count;
+    bool home;
+    bool frame_ready;
+    uint64_t frames, reads, clears, start_nacks;
+    bool require_power;
+    int (*powered)(void *opaque);   /* board callback: is the touch rail on? */
+    void *powered_opaque;
+};
+
+void x4pro_gt911_set_touch(X4ProGt911State *s, const Gt911Point *pts, int count, bool home);
+
+/* ---- PCF8563 / BM8563 ----------------------------------------------------- */
+#define TYPE_X4PRO_PCF8563 "x4pro.pcf8563"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProPcf8563State, X4PRO_PCF8563)
+
+struct X4ProPcf8563State {
+    I2CSlave parent_obj;
+    uint8_t regs[16];
+    uint8_t ptr;
+    int byte_index;
+    int64_t base_epoch;           /* seconds: wall time corresponding to guest virtual time base_vt */
+    int64_t base_vt_ns;
+    uint64_t reads, writes;
+};
+
+/* ---- CW2017 --------------------------------------------------------------- */
+#define TYPE_X4PRO_CW2017 "x4pro.cw2017"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProCw2017State, X4PRO_CW2017)
+
+struct X4ProCw2017State {
+    I2CSlave parent_obj;
+    uint8_t regs[0x60];
+    uint8_t ptr;
+    int byte_index;
+    uint32_t soc;                 /* percent */
+    uint32_t mv;                  /* millivolts */
+    uint64_t reads, writes, batinfo_writes;
+};
+
+void x4pro_cw2017_set_battery(X4ProCw2017State *s, int soc, int mv);
diff --git a/include/hw/misc/x4pro_sleep.h b/include/hw/misc/x4pro_sleep.h
new file mode 100644
index 0000000..1f56811
--- /dev/null
+++ b/include/hw/misc/x4pro_sleep.h
@@ -0,0 +1,37 @@
+/*
+ * Deep-sleep model for the ESP32-S3 RTC_CNTL block: overlays the sleep-related
+ * registers on top of Espressif's rtc_cntl (which ignores them) and forwards
+ * everything else to it.
+ * x4pro-emu, GPL-2.0-or-later.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/misc/esp32s3_rtc_cntl.h"
+
+#define TYPE_X4PRO_SLEEP "x4pro.sleep"
+OBJECT_DECLARE_SIMPLE_TYPE(X4ProSleepState, X4PRO_SLEEP)
+
+struct X4ProSleepState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    MemoryRegion *lower;          /* the stock rtc_cntl register region */
+    Esp32s3RtcCntlState *rtc;
+
+    uint32_t wakeup_state;        /* +0x3C */
+    uint32_t int_ena, int_raw;    /* +0x40, +0x44 */
+    uint32_t ext_wakeup_conf;     /* +0x64: bit 31 EXT1 level (1 = any high, 0 = any low) */
+    uint32_t slp_reject_conf;     /* +0x68 */
+    uint32_t dig_pwc;             /* +0x90: bit 31 DG_WRAP_PD_EN => deep sleep */
+    uint32_t ext_wakeup1;         /* +0xE0: bits 0..21 RTC IO select */
+    uint32_t ext_wakeup1_status;  /* +0xE4 */
+    uint32_t wakeup_cause;        /* +0x130 */
+
+    bool sleeping;
+    bool deep;
+    uint64_t sleep_count, wake_count, light_sleeps;
+    int64_t sleep_entered_us;
+    uint32_t gpio_levels;         /* pins 0..21 as last reported on "gpio-in" */
+};
+
+void x4pro_sleep_wake(X4ProSleepState *s, int rtc_io);
