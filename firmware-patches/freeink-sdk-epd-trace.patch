+
+// ---- x4pro-emu: optional panel command trace (build with -DFREEINK_EPD_TRACE=1) ----
+// One line per command, printed when the next command starts (so the data length
+// is known): "[EPD] c=XX len=N d=b0 b1 .. b7". Used to record fixtures for the
+// emulator's panel model. Not for production builds.
+#if defined(FREEINK_EPD_TRACE) && FREEINK_EPD_TRACE
+namespace {
+struct EpdTrace {
+  int cmd = -1;
+  uint32_t len = 0;
+  uint8_t head[8];
+  uint32_t t0 = 0;
+  void flush() {
+    if (cmd < 0 || !Serial) return;
+    Serial.printf("[%lu] [EPD] c=%02X len=%lu", (unsigned long)t0, cmd, (unsigned long)len);
+    const uint32_t n = len < 8 ? len : 8;
+    for (uint32_t i = 0; i < n; i++) Serial.printf(" %02X", head[i]);
+    Serial.printf("\n");
+    cmd = -1;
+  }
+  void command(uint8_t c) {
+    flush();
+    cmd = c;
+    len = 0;
+    t0 = millis();
+  }
+  void data(const uint8_t* d, uint32_t n) {
+    for (uint32_t i = 0; i < n && len + i < 8; i++) head[len + i] = d[i];
+    len += n;
+  }
+};
+EpdTrace g_epdTrace;
+}  // namespace
+#define EPD_TRACE_CMD(c) g_epdTrace.command(c)
+#define EPD_TRACE_DATA(d, n) g_epdTrace.data((d), (n))
+#define EPD_TRACE_BYTE(b) do { const uint8_t _b = (b); g_epdTrace.data(&_b, 1); } while (0)
+#define EPD_TRACE_FLUSH() g_epdTrace.flush()
+#else
+#define EPD_TRACE_CMD(c)
+#define EPD_TRACE_DATA(d, n)
+#define EPD_TRACE_BYTE(b)
+#define EPD_TRACE_FLUSH()
+#endif
+
