# device dumps (they hold the owner's WiFi credentials), card images, build output: never committed.
# Anchored to the root so docs/images/ (the README's pictures) stays tracked.
/images/
.x4emu/
.venv/
.venv-pio/
__pycache__/
*.pyc
build/
.pytest_cache/
*.egg-info/
dist/
*.log
!docs/device/*.log
qemu/

# Font binaries: proprietary copies (bookerly, georgia, misans) must not be published, and
# the open ones are one curl away. fonts/README.md says what belongs here.
fonts/*
!fonts/README.md
.DS_Store
