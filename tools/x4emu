#!/usr/bin/env python3
"""x4emu — in-repo entry point for the CLI (the code lives in the `x4emu` package at the repo root).

The same CLI can be installed (`pipx install .` / `pip install -e .`, console script `x4emu`); this
script runs it straight from a checkout with nothing installed, which is how tests/conftest.py, the
Makefile and CLAUDE.md invoke it (tools/x4emu_mcp.py imports the package instead):

    .venv/bin/python tools/x4emu [--json] [--name NAME] COMMAND ...

Usage and the JSON shapes: `tools/x4emu --help` and docs/x4emu.md.
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)                      # import the package from this checkout, not site-packages
os.environ.setdefault('X4EMU_ROOT', ROOT)     # ... and drive this checkout's qemu/, .x4emu/, docs/

from x4emu.cli import main                    # noqa: E402

if __name__ == '__main__':
    main()
